 	PINMUX_CONFIG(PWR_GPIO5, PWR_GPIO5, G7); 	//FAN0_EN
 	PINMUX_CONFIG(SD1_D0, PWM17, G11);			//FAN0_PWM
-	PINMUX_CONFIG(CAN0_RX, GPIO106, G11);		//FAN0_TACH
