 	//DEVICE FAN1
 	PINMUX_CONFIG(PWR_GPIO6, PWR_GPIO6, G7); 	//FAN1_EN
 	PINMUX_CONFIG(SD1_D1, PWM18, G11);			//FAN1_PWM
-	PINMUX_CONFIG(SD1_CLK, GPIO62, G11);		//FAN1_TACH
