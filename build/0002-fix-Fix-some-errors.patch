From: "wangliang.wang" <wangliang.wang@sophgo.com>
Date: Thu, 23 Apr 2026 19:09:55 +0800
Subject: [PATCH 2/9] [fix]Fix some errors. 1.pwm-fan pinmux need PWM func.
 2.refine pwm-fan dts config. 3.fix uboot build error.

Change-Id: Ifbea17084d4a5f2f9819d9ea6189a326ca4357fe
---
 .../dts_arm64/bm1688_ubuntu_ainas_16G.dts     | 14 +++---
 .../linux/edge_ubuntu_emmc_ainas_defconfig    | 49 +++++++++++++++++++
 .../u-boot/cvi_board_init.c                   |  6 +--
 .../u-boot/edge_ubuntu_emmc_ainas_defconfig   |  2 +-
 4 files changed, 60 insertions(+), 11 deletions(-)

diff --git a/boards/sophon/edge_ubuntu_emmc_ainas/dts_arm64/bm1688_ubuntu_ainas_16G.dts b/boards/sophon/edge_ubuntu_emmc_ainas/dts_arm64/bm1688_ubuntu_ainas_16G.dts
index 42d07b9..e2700f5 100644
--- a/boards/sophon/edge_ubuntu_emmc_ainas/dts_arm64/bm1688_ubuntu_ainas_16G.dts
+++ b/boards/sophon/edge_ubuntu_emmc_ainas/dts_arm64/bm1688_ubuntu_ainas_16G.dts
@@ -96,18 +96,20 @@
 	
 	dev_fan0: pwm-fan1 {
 		compatible = "pwm-fan";
+		pwm-names = "fan", "tach";
 		#cooling-cells = <2>;
-	 	pwms = <&pwm4 1 1000000>; // default pwm17, 1ms period, normal polarity
-		interrupts-extended = <&portd 10 IRQ_TYPE_EDGE_FALLING>; //GPIO106 fan tach
+	 	pwms = <&pwm4 1 1000000>,<&pwm0 3 1000000>; // default pwm17, 1ms period, normal polarity
 		pulses-per-revolution = <2>;	//fan-tach PPR, default 2
+		default-pwm = <80>; // Set the fan speed to 30% of its maximum speed
 	};
 
 	dev_fan1: pwm-fan2 {
 		compatible = "pwm-fan";
+		pwm-names = "fan", "tach";
 		#cooling-cells = <2>;
-		pwms = <&pwm4 2 1000000>; // default pwm18, 1ms period, normal polarity
-		interrupts-extended = <&portb 30 IRQ_TYPE_EDGE_FALLING>; //GPIO62 fan tach
+		pwms = <&pwm4 2 1000000>,<&pwm3 3 1000000>; // default pwm18, 1ms period, normal polarity
 		pulses-per-revolution = <2>;	//fan-tach PPR, default 2
+		default-pwm = <80>; // Set the fan speed to 30% of its maximum speed
 	};
 };
 
@@ -182,9 +184,7 @@
 };
 
 &fan0 {
-	pwm-names = "fan";
-	pwms = <&pwm4 0 1000000>; // default pwm16, 1ms period, normal polarity
-	interrupts-extended = <&portd 9 IRQ_TYPE_EDGE_FALLING>; //GPIO105 fan tach
+	pwms = <&pwm4 0 1000000>,<&pwm0 2 1000000>; // default pwm16, 1ms period, normal polarity
 };
 
 &i2c6 {
