+++ b/boards/sophon/edge_ubuntu_emmc_ainas/u-boot/cvi_board_init.c
@@ -184,7 +184,7 @@ int cvi_board_init(void)
 	//SOC FAN
 	PINMUX_CONFIG(PWR_GPIO4, PWR_GPIO4, G7); 	//SOC_FAN_EN
 	PINMUX_CONFIG(SD1_CMD, PWM16, G11);			//SOC_FAN_PWM
-	PINMUX_CONFIG(CAN0_TX, GPIO105, G11);		//SOC_FAN_TACH
