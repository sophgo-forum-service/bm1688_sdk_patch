             # try:
             #     label = part["label"]
             # except KeyError:
@@ -77,9 +86,12 @@ class ImagerBuilder(object):
             for _ in range(len(label), 32):
                 Extra_flags.append(ord("\0"))
 
+            Reserve = array("I", [0])
+            Large_file_flag = array("I", [LARGE_FILE_MAGIC_NUM])
+
             img = open(file_path + ".head", "wb")
             # Write Header
-            for h in [Magic, Version, Chunk_sz, Totak_chunk, File_sz, Extra_flags]:
+            for h in [Magic, Version, Chunk_sz, Totak_chunk, File_sz, Extra_flags, Reserve, Large_file_flag]:
                 h.tofile(img)
