+#----------------------------------------------------------------------------
+# Edge (ubuntu/debian rootfs) partition packing
+#
+# The images are generated according to "$FLASH_PARTITION_XML", for example
+# build/boards/sophon/edge_ubuntu_emmc_ainas/partition/partition_emmc.xml :
+#
+#   "$OUTPUT_DIR"/rawimages/<file> : raw image, same size as the partition
+#   "$OUTPUT_DIR"/<file>           : the raw image with a CIMG header, it is
+#                                    the image the usb download tool burns
+#
+# pack_edge_boot      -> boot.emmc      (boot.itb, boot.scr.emmc, fip.bin ...)
+# pack_edge_recovery  -> recovery.emmc  (recovery.itb)
+# pack_edge_misc      -> misc.emmc      (empty partition)
+# pack_edge_rootfs    -> rootfs.emmc    (read only rootfs)
+# pack_edge_rootfs_rw -> rootfs_rw.emmc (overlay: /opt and /home/linaro)
+# pack_edge_data      -> data.emmc      (user data)
+#----------------------------------------------------------------------------
+
+# $1 : partition label, for example BOOT
+# $2 : attribute name, for example size_in_kb
+function edge_partition_attr
+{
+  local label="$1"
+  local attr="$2"
+  local line
+
+  line=$(grep -E "<partition[^>]+label=\"$label\"" "$FLASH_PARTITION_XML" | head -n 1)
+  if [ -z "$line" ]; then
+    print_error "partition $label is not found in $FLASH_PARTITION_XML"
+    return 1
+  fi
+  echo "$line" | sed -n "s/.*[[:blank:]]$attr=\"\([^\"]*\)\".*/\1/p"
+}
+
+# Create "$OUTPUT_DIR"/rawimages/<file> with the size and the file system
+# described in the partition xml.
+# $1 : partition label
+# $2 : directory or file copied into the partition, "" for an empty partition
+function pack_edge_partition
+{
+  local label="$1"
+  local src="$2"
+  local type
+  local file
+  local size_kb
+  local img
+  local img_kb
+  local mnt
+  local ret
+  local src_kb
+
+  type=$(edge_partition_attr "$label" type) || return 1
+  file=$(edge_partition_attr "$label" file) || return 1
+  size_kb=$(edge_partition_attr "$label" size_in_kb) || return 1
+
+  if [ -z "$file" ]; then
+    print_error "partition $label has no \"file\" attribute in $FLASH_PARTITION_XML"
+    return 1
+  fi
+  # A partition without size_in_kb(empty or missing, like the DATA row of the
+  # edge tables) is sized by mk_gpt(see write_partition() of mk_gpt.c), its
+  # image only has to hold the content, so it is generated with the size of
+  # the content(the shrink path below).
+  if [ -z "$size_kb" ]; then
+    print_notice "partition $label has no size_in_kb, its image is generated from its content"
+  fi
+  if [ -n "$src" ] && [ ! -e "$src" ]; then
+    print_error "the source \"$src\" of partition $label does not exist"
+    return 1
+  fi
+
+  print_notice "pack $label -> rawimages/$file (size ${size_kb:-auto}KB, ${type:-raw})"
+
+  # size of the source, it checks the partition and it sizes the file system
+  # of a shrunk image(below)
+  src_kb=0
+  if [ -n "$src" ]; then
+    if [ -d "$src" ]; then
+      src_kb=$(sudo du -s -k "$src" | awk '{print $1}')
+    else
+      src_kb=$(( ($(stat --dereference --format=%s "$src") + 1023) / 1024 ))
+    fi
+    if [ -n "$size_kb" ] && [ "$src_kb" -gt "$size_kb" ]; then
+      print_error "$src(${src_kb}KB) is larger than partition $label(${size_kb}KB)"
+      return 1
+    fi
+  fi
+
+  # The image holds the whole partition by default. When the image is shrunk,
+  # the file system is created just as large as the content needs : the blocks
+  # are allocated in a dense way and resize2fs -M(below) cuts the image to a
+  # much smaller size than creating the file system with the size of the whole
+  # partition first(blocks are spread over the whole file system then).
+  img_kb="$size_kb"
+  if [ "${EDGE_SHRINK_FS:-1}" != 0 ] && edge_shrink_needed "$label" && [ "$src_kb" -gt 0 ]; then
+    img_kb=$(( src_kb + src_kb / 3 + 65536 ))
+    if [ -n "$size_kb" ] && [ "$img_kb" -gt "$size_kb" ]; then
+      img_kb="$size_kb"
+    fi
+    print_notice "  create the file system with ${img_kb}KB(content ${src_kb}KB) before shrink"
+  fi
+
+  if [ -z "$img_kb" ]; then
+    print_error "can not size the image of partition $label: give its size_in_kb or add it to EDGE_SHRINK_FS_LABELS"
+    return 1
+  fi
+
+  mkdir -p "$OUTPUT_DIR"/rawimages || return 1
+  img="$OUTPUT_DIR"/rawimages/"$file"
+  sudo rm -f "$img" || return 1
+  dd if=/dev/zero of="$img" bs=1024 count="$img_kb" status=none || return 1
+
+  case "$type" in
+    fat*|vfat)
+      sudo mkfs.vfat -F 32 -n "$label" "$img" >/dev/null || return 1
+      ;;
+    ext*)
+      sudo mkfs.ext4 -F -q -m 0 -L "$label" "$img" || return 1
+      ;;
+    "")
+      echo "$label has no file system"
+      ;;
+    *)
+      print_error "unsupported type \"$type\" of partition $label"
+      return 1
+      ;;
+  esac
+
+  # raw partition, put the source blob (if any) at the beginning of the image
+  if [ -z "$type" ]; then
+    if [ -n "$src" ] && [ -f "$src" ]; then
+      sudo dd if="$src" of="$img" conv=notrunc status=none || return 1
+    fi
+    return 0
+  fi
+
+  # empty partition, only the file system was created
+  if [ -z "$src" ]; then
+    return 0
+  fi
+
+  mnt=$(mktemp -d)
+  if ! sudo mount "$img" "$mnt"; then
+    print_error "mount $file failed"
+    rmdir "$mnt"
+    return 1
+  fi
+
+  ret=0
+  if [ -d "$src" ]; then
+    # keep the owner/mode of every file, tar can copy over 8.86GB partition
+    sudo bash -c "tar -C '$src' -cf - . | tar -C '$mnt' -xpf -" || ret=1
+  else
+    sudo cp -a "$src" "$mnt"/ || ret=1
+  fi
+  sudo sync
+  sleep 1
+  sudo umount "$mnt" || ret=1
+  rmdir "$mnt"
+
+  if [ "$ret" != 0 ]; then
+    print_error "copy files to partition $label failed"
+    return 1
+  fi
+
+  case "$type" in
+    ext*)
+      sudo e2fsck -f -p "$img" >/dev/null
+      ret=$?
+      if [ "$ret" -ge 4 ]; then
+        print_error "e2fsck $file failed($ret)"
+        return 1
+      fi
+      if [ "${EDGE_SHRINK_FS:-1}" != 0 ] && edge_shrink_needed "$label"; then
+        edge_shrink_fs "$img" || return 1
+      fi
+      ;;
+  esac
+}
+
+# Only the big ext4 partitions are worth to be shrunk, the small ones(misc,
+# recovery ...) are kept as large as their partitions.
+# $1 : partition label, return 0 when the image of the partition is shrunk
+function edge_shrink_needed
+{
+  local label
+
+  for label in ${EDGE_SHRINK_FS_LABELS:-ROOTFS ROOTFS_RW DATA}; do
+    if [ "$label" = "$1" ]; then
+      return 0
+    fi
+  done
+  return 1
+}
+
+# Shrink the ext4 image to its minimum size, just like what the ota package
+# does(see do_gen_partition_subimg() of bm_make_package_sectors.sh) : the
+# image which is packed/burnt is smaller and the program time is shorter.
+# The filesystem has to be grown back to the size of the partition on the
+# target(resize-helper / expand.sh).
+# Only the partitions of EDGE_SHRINK_FS_LABELS are shrunk, and
+# EDGE_SHRINK_FS=0 disables the shrink at all.
+# $1 : path of the ext4 image
+function edge_shrink_fs
+{
+  local img="$1"
+  local block_size
+  local blocks
+  local size
+
+  sudo resize2fs -M "$img" || return 1
+
+  # resize2fs truncates the file when it can, cut it ourself if it did not
+  block_size=$(sudo dumpe2fs -h "$img" 2>/dev/null | awk -F: '/Block size:/{gsub(/[ \t]/,"",$2);print $2}')
+  blocks=$(sudo dumpe2fs -h "$img" 2>/dev/null | awk -F: '/Block count:/{gsub(/[ \t]/,"",$2);print $2}')
+  if [ -n "$block_size" ] && [ -n "$blocks" ]; then
+    size=$((block_size * blocks))
+    if [ "$(stat --format=%s "$img")" -gt "$size" ]; then
+      sudo truncate -s "$size" "$img" || return 1
+    fi
+  fi
+
+  # the shrunk image must be clean
+  sudo e2fsck -f -p "$img" >/dev/null
+  if [ $? -ge 4 ]; then
+    print_error "e2fsck $img failed after resize2fs"
+    return 1
+  fi
+
+  print_notice "  shrink $img to $(stat --format=%s "$img")B"
+}
+
+# $1 : partition label, print the offset(in KB) of the partition in the xml
+function edge_partition_offset_kb
+{
+  awk -v want="$1" '
+    /<!--/ { in_comment = 1 }
+    in_comment && /-->/ { in_comment = 0; next }
+    in_comment { next }
+    /<partition[ \t>]/ {
+      if (match($0, /label="[^"]+"/) == 0)
+        next
+      label = substr($0, RSTART + 7, RLENGTH - 8)
+      size = 0
+      if (match($0, /size_in_kb="[0-9]+"/))
+        size = substr($0, RSTART + 12, RLENGTH - 13) + 0
+      if (label == want) {
+        print off
+        exit
+      }
+      off += size
+    }
+  ' "$FLASH_PARTITION_XML"
+}
+
+# The offset/part_size of the chunk header and the file size of the container
+# header are described by a low/high 32bit pair, so an image larger than 4GiB
+# and a partition behind the first 4GiB of the eMMC are supported by the
+# generator and by the u-boot(_prgImage() of u-boot-2021.10/cmd/cvi_update.c).
+# The check below is only needed when the board still runs an old u-boot or
+# when the old usb download tool is used : it reads the 32bit part of these
+# fields only and programs the partition to a wrong offset then.
+# Set EDGE_CIMG_32BIT_LIMIT=1 to keep the images below/inside the first 4GiB.
+# $1 : partition label, return 0 when the partition can be packed
+function edge_cimg_packable
+{
+  local label="$1"
+  local file
+  local size
+  local offset_kb
+  local max=$((0xFFFFFFFF))
+
+  if [ "${EDGE_CIMG_32BIT_LIMIT:-0}" = 0 ]; then
+    return 0
+  fi
+
+  file=$(edge_partition_attr "$label" file) || return 1
+  size=$(stat --dereference --format=%s "$OUTPUT_DIR"/rawimages/"$file") || return 1
+  offset_kb=$(edge_partition_offset_kb "$label")
+
+  # File_sz = image size + one 64 bytes chunk header for every 16MB chunk
+  if [ $((size + (size / 16777216 + 1) * 64)) -gt "$max" ]; then
+    print_error "partition $label can not be packed as CIMG image:"
+    print_error "  the image size(${size}B) is beyond the 32bit limit(${max}B) of the CIMG header"
+    return 1
+  fi
+  if [ $((offset_kb * 1024 + size)) -gt "$max" ]; then
+    print_error "partition $label can not be programmed by the usb download tool:"
+    print_error "  its offset(${offset_kb}KB) + size(${size}B) is beyond the 32bit limit(${max}B) of the CIMG header"
+    return 1
+  fi
+  return 0
+}
+
+# Add the CIMG header to the raw image of the partition, the result is the
+# image the usb download tool burns to the board.
+# $1 : partition label
+function pack_edge_burning_img
+{
+  local file
+
+  file=$(edge_partition_attr "$1" file) || return 1
+  if [ ! -f "$OUTPUT_DIR"/rawimages/"$file" ]; then
+    print_error "$OUTPUT_DIR/rawimages/$file does not exist"
+    return 1
+  fi
+
+  if ! edge_cimg_packable "$1"; then
+    print_error "  skip rawimages/$file, please program partition $1 with the update package(build_update usb)"
+    return 0
+  fi
+
+  python3 "$IMGTOOL_PATH"/raw2cimg.py \
+    "$OUTPUT_DIR"/rawimages/"$file" "$OUTPUT_DIR" "$FLASH_PARTITION_XML"
+  if [ $? != 0 ]; then
+    print_error "pack rawimages/$file with CIMG header failed"
+    return 1
+  fi
+}
+
+function pack_edge_boot
+{
+  print_notice "Run ${FUNCNAME[0]}() function"
+  pack_edge_partition BOOT "$PACKAGE_OUTPUT_DIR"/boot || return $?
+  pack_edge_burning_img BOOT
+}
+
+function pack_edge_recovery
+{
+  print_notice "Run ${FUNCNAME[0]}() function"
+  pack_edge_partition RECOVERY "$PACKAGE_OUTPUT_DIR"/recovery.itb || return $?
+  pack_edge_burning_img RECOVERY
+}
+
+function pack_edge_misc
+{
+  print_notice "Run ${FUNCNAME[0]}() function"
+  pack_edge_partition MISC "" || return $?
+  pack_edge_burning_img MISC
+}
+
+function pack_edge_rootfs
+{
+  print_notice "Run ${FUNCNAME[0]}() function"
+  pack_edge_partition ROOTFS "$EDGE_ROOTFS_DIR" || return $?
+  pack_edge_burning_img ROOTFS
+}
+
+function pack_edge_rootfs_rw
+{
+  print_notice "Run ${FUNCNAME[0]}() function"
+  pack_edge_partition ROOTFS_RW "$PACKAGE_OUTPUT_DIR"/rootfs_rw || return $?
+  pack_edge_burning_img ROOTFS_RW
+}
+
+function pack_edge_data
+{
+  print_notice "Run ${FUNCNAME[0]}() function"
+  pack_edge_partition DATA "$PACKAGE_OUTPUT_DIR"/data || return $?
+  pack_edge_burning_img DATA
+}
+
+# The usb download tool reads the partition table from the folder which holds
+# the images, so copy it into the burning folder.
+function pack_edge_partition_xml
+{
+  print_notice "Run ${FUNCNAME[0]}() function"
+  command cp -f "$FLASH_PARTITION_XML" "$OUTPUT_DIR"/ || return $?
+}
+
 function pack_cfg
 {(
   print_notice "Run ${FUNCNAME[0]}_${STORAGE_TYPE}() function"
diff --git a/envsetup_soc.sh b/envsetup_soc.sh
