@@ -0,0 +1,244 @@
+/dts-v1/;
+#include "soph_base_arm64.dtsi"
+//#include "soph_asic_bga.dtsi"
+#include "soph_asic_emmc.dtsi"
+#include "soph_default_memmap.dtsi"
+
+/ {
+	aliases {
+		serial0 = &uart0;
+		mmc0 = &emmc;
+	};
+
+	chosen {
+		stdout-path = "serial0"; // "serial0:115200n8", no arguments means no re-initialization
+	};
+	
+	memory@100000000 {
+		device_type = "memory";
+		reg = <0x1 0x00000000 0x2 0x00000000>;  //8G
+    };
+
+	reserved-memory {
+		#address-cells = <0x2>;
+		#size-cells = <0x2>;
+		ranges;
+#ifndef __UBOOT__
+		//0x1_0400_0000 - 0x1_2400_0000 for TPU (owner: zhuolin.li@sophgo.com)
+		//Don't move the TPU address
+		scalar_reserved: scalar_mem {
+			reg = <0x1 0x04000000 0x0 0x10000000>;  //512MB for TPU firmware
+			no-map;
+		};
+		//0x1_7A00_0000 - 0x1_DA00_0000 for TPU (owner: zhuolin.li@sophgo.com)
+		ion_for_npu: ion_npu_mem {
+			compatible = "npu-region";
+			reg = <0x1 0x7A000000 0x0 0x60000000>; // 1.5G, for TPU
+		};
+		//0x2_0000_0000 - 0x3_0000_0000 for VPP (owner: kenneth.liu@sophgo.com)
+		ion_for_vpp: ion_vpp_mem {
+			compatible = "vpp-region";
+			reg = <0x2 0x00400000 0x0 0xFFC00000>; // 4G, for VPP
+		};
+#endif
+	};
+
+	gpio-keys {
+		compatible = "gpio-keys";
+
+		recovery {
+			label = "recovery key";
+			gpios = <&portg 15 GPIO_ACTIVE_LOW>;
+			linux,code = <0x290>;				/* KEY_MACRO1*/
+			linux,input-type = <EV_KEY>;
+			debounce-interval = <20>;
+			wakeup-source;
+		};
+/*
+		power_key {
+			label = "power key";
+			gpios = <&portg 8 GPIO_ACTIVE_LOW>;
+			linux,code = <116>;				//KEY_POWER
+			linux,input-type = <EV_KEY>;
+			debounce-interval = <20>;
+			wakeup-source;
+		};
+*/
+	};
+
+	beeper: pwm-beeper {
+        compatible = "pwm-beeper";
+        /* #pwm-cells = <2> => <channel period_ns> */
+        pwms = <&pwm0 1 1000000>;  /* 通道1, 1kHz */
+        status = "okay";
+    };
+
+	wifi_pin {
+		compatible = "cvitek,wifi-pin";
+		poweron-gpio = <&portf 15 GPIO_ACTIVE_HIGH>;
+		wakeup-gpio = <&portg 16 GPIO_ACTIVE_HIGH>;
+	};
+
+	bt_pin {
+		compatible = "cvitek,bt-pin";
+		poweron-gpio = <&portf 14 GPIO_ACTIVE_HIGH>;
+	};
+
+	/delete-node/ cv-sd@29310000;
+	/delete-node/ wifi-sd@29330000;
+	wifi-sd@29310000 {
+		compatible = "cvitek,cv186x-sd";
+		reg = <0x0 0x29310000 0x0 0x10000>;
+		reg-names = "core_mem";
+		bus-width = <4>;
+		no-sd;
+		no-mmc;
+		non-removable;
+		src-frequency = <383333334>;
+		min-frequency = <400000>;
+		max-frequency = <200000000>;
+		64_addressing;
+		reset_tx_rx_phy;
+		interrupts = <GIC_SPI 90 IRQ_TYPE_LEVEL_HIGH>;
+	};
+
+	/delete-node/ gpio_leds;
+	
+	hdd1_led {
+        compatible = "dual-color-leds";
+		red-gpios = <&porte 18 GPIO_ACTIVE_HIGH>;
+		blue-gpios = <&porte 19 GPIO_ACTIVE_HIGH>;
+		default-state = <0>;           /* 0=off, 1=blue, 2=red, 3=blue-blink, 4=red-blink, 5=alt-blink */
+    	default-blink-ms = <500>;      /* 闪烁间隔，100-10000ms */
+    };
+	hdd2_led {
+        compatible = "dual-color-leds";
+		red-gpios = <&porte 20 GPIO_ACTIVE_HIGH>;
+		blue-gpios = <&porte 21 GPIO_ACTIVE_HIGH>;
+		default-state = <0>;           /* 0=off, 1=blue, 2=red, 3=blue-blink, 4=red-blink, 5=alt-blink */
+    	default-blink-ms = <500>;      /* 闪烁间隔，100-10000ms */
+    };
+	status_led {
+        compatible = "dual-color-leds";
+		red-gpios = <&porte 30 GPIO_ACTIVE_HIGH>;
+		blue-gpios = <&portf 4 GPIO_ACTIVE_HIGH>;
+		default-state = <0>;           /* 0=off, 1=blue, 2=red, 3=blue-blink, 4=red-blink, 5=alt-blink */
+    	default-blink-ms = <500>;      /* 闪烁间隔，100-10000ms */
+    };
+
+
+	dev_fan0: pwm-fan1 {
+		compatible = "pwm-fan";
+		pwm-names = "fan", "tach";
+		#cooling-cells = <2>;
+	 	pwms = <&pwm4 1 1000000>,<&pwm0 3 1000000>; // default pwm17, 1ms period, normal polarity
+		pulses-per-revolution = <2>;	//fan-tach PPR, default 2
+		default-pwm = <80>; // Set the fan speed to 30% of its maximum speed
+	};
+
+	dev_fan1: pwm-fan2 {
+		compatible = "pwm-fan";
+		pwm-names = "fan", "tach";
+		#cooling-cells = <2>;
+		pwms = <&pwm4 2 1000000>,<&pwm3 3 1000000>; // default pwm18, 1ms period, normal polarity
+		pulses-per-revolution = <2>;	//fan-tach PPR, default 2
+		default-pwm = <80>; // Set the fan speed to 30% of its maximum speed
+	};
+};
+
+&uart0 {
+	clock-frequency = <200000000>;
+	current-speed = <115200>;
+};
+
+&usbdrd3_0 {
+	usbdrd_dwc3_0: usb@39010000 {
+		role-switch-default-mode = "host";
+	};
+};
+
+&usbdrd3_1 {
+	usbdrd_dwc3_1: usb@39110000 {
+		role-switch-default-mode = "host";
+	};
+};
+
+&ethernet0 {
+	phy-handle = <&phy0>;
+	mdio {
+		#address-cells = <0x1>;
+		#size-cells = <0x0>;
+		compatible = "snps,dwmac-mdio";
+		phy0: phy@0 {
+			rx-internal-delay-ps = <2100>;
+			tx-internal-delay-ps = <2100>;
+			compatible = "ethernet-phy-id4f51.e91b";
+			device_type = "ethernet-phy";
+			led0_config = <0x7>;
+			led1_config = <0x19f0>;
+			led2_config = <0x0>;
+			reg = <0x0>;
+		};
+	};
+};
+
+&ethernet1 {
+	phy-handle = <&phy1>;
+	mdio {
+		#address-cells = <0x1>;
+		#size-cells = <0x0>;
+		compatible = "snps,dwmac-mdio";
+		phy1: phy@1 {
+			rx-internal-delay-ps = <2100>;
+			tx-internal-delay-ps = <2100>;
+			compatible = "ethernet-phy-id4f51.e91b";
+			device_type = "ethernet-phy";
+			led0_config = <0x7>;
+			led1_config = <0x19f0>;
+			led2_config = <0x0>;
+			reg = <0x0>;
+		};
+	};
+};
+
+&pcie0 {
+	status = "disabled";
+	reset-gpio = <&porte 1 GPIO_ACTIVE_HIGH>; //gpio 129
+};
+
+&pcie1 {
+	status = "okay";
+	reset-gpio = <&porte 2 GPIO_ACTIVE_HIGH>; //gpio 130
+};
+
+&sata {
+	status = "okay";  //pcie0 used for sata, disable sata controller
+	compatible = "snps,dwc-ahci";
+};
+
+&fan0 {
+	pwms = <&pwm4 0 1000000>,<&pwm0 2 1000000>; // default pwm16, 1ms period, normal polarity
+};
+
+&i2c6 {
+	rtc@51 {
+		compatible = "Haoyu,hym8563";
+		init_date = "2024/01/01";
+		reg = <0x51>;
+	};
+};
+
+&hdmi {
+	phy-table =
+			<0  0x0007 0x0120 0x8d88>,
+			<1  0x0007 0x0120 0x8d88>,
+			<2  0x0007 0x0120 0x8d88>,
+			<3  0x0007 0x0120 0x8d88>,
+			<4  0x0007 0x0120 0x8d88>,
+			<5  0x0007 0x0120 0x8d88>,
+			<6  0x0000 0x0120 0x83F8>,
+			<7  0x0000 0x0120 0x83F8>,
+			<8  0x0000 0x0120 0x83F8>,
+			<9  0x0000 0x0080 0x8FF4>,
+			<10 0x0000 0x0080 0x8FF4>;
+};
\ No newline at end of file
