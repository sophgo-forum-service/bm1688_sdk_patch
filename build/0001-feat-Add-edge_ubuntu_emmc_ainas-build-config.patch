+		scalar_reserved: scalar_mem {
+			reg = <0x1 0x04000000 0x0 0x10000000>;  //512MB for TPU firmware
+			no-map;
+		};
+
+		cma_reserved: linux,cma {
+			compatible = "shared-dma-pool";
+			reusable;
+			size = <0x0 0x10000000>; // 256m for drm 0x7C00000->0x10000000
+			alloc-ranges = <0x1 0x30000000 0x0 0x10000000>;   // to fix hdmi audio bug 0x7C00000->0x10000000 0x40400000->0x30000000
+			alignment = <0x0 0x100000>; // 1MB
+			linux,cma-default;
+		};
+
+		ion_for_npu: ion_npu_mem {
+			compatible = "npu-region";
+			reg = <0x2 0x00000000 0x0 0xC0000000>; // 3G, for npu
