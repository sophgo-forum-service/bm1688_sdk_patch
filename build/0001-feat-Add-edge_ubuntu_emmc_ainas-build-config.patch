+#ifndef CONFIG_SPL_BUILD
+int cvi_board_pinctrl(void)
+{
+	//SATA
+	gpio_request(SATA_3V3_EN, "SATA_3V3_EN");
+	gpio_request(SATA0_12V_EN, "SATA0_12V_EN");
+	gpio_request(SATA1_12V_EN, "SATA1_12V_EN");
+	gpio_request(SATA2_12V_EN, "SATA2_12V_EN");
+	gpio_request(SATA3_12V_EN, "SATA3_12V_EN");
+	gpio_request(SATA4_12V_EN, "SATA4_12V_EN");
+	gpio_request(SATA0_5V_EN, "SATA0_5V_EN");
+	gpio_request(SATA1_5V_EN, "SATA1_5V_EN");
+	gpio_request(SATA2_5V_EN, "SATA2_5V_EN");
+	gpio_request(SATA3_5V_EN, "SATA3_5V_EN");
+	gpio_request(SATA4_5V_EN, "SATA4_5V_EN");
+
+	gpio_direction_output(SATA_3V3_EN, 1);
+	gpio_direction_output(SATA0_12V_EN, 1);
+	gpio_direction_output(SATA1_12V_EN, 1);
+	gpio_direction_output(SATA2_12V_EN, 1);
+	gpio_direction_output(SATA3_12V_EN, 1);
+	gpio_direction_output(SATA4_12V_EN, 1);
+	gpio_direction_output(SATA0_5V_EN, 1);
+	gpio_direction_output(SATA1_5V_EN, 1);
+	gpio_direction_output(SATA2_5V_EN, 1);
+	gpio_direction_output(SATA3_5V_EN, 1);
+	gpio_direction_output(SATA4_5V_EN, 1);
+
+	//PCIE
+	gpio_request(PCIE0_RC_RST, "PCIE0_RC_RST");
+	gpio_request(PCIE1_RC_RST, "PCIE1_RC_RST");
+	gpio_direction_output(PCIE0_RC_RST, 1);
+	gpio_direction_output(PCIE1_RC_RST, 1);
+
+	//NVME
+	gpio_request(NVME_EN, "NVME_EN");
+	gpio_request(NVME0_ALERT, "NVME0_ALERT");
+	gpio_direction_output(NVME_EN, 1);
+	gpio_direction_output(NVME0_ALERT, 1);
+
+	//USB
+	gpio_request(SOC_HUB_RESET, "SOC_HUB_RESET");
+	gpio_request(SOC_HUB_EN, "SOC_HUB_EN");
+	gpio_request(USB_PT1_EN, "USB_PT1_EN");
+	gpio_request(USB_PT2_EN, "USB_PT2_EN");
+	gpio_request(USB_PT3_EN, "USB_PT3_EN");
+	gpio_direction_output(SOC_HUB_RESET, 1);
+	gpio_direction_output(SOC_HUB_EN, 1);
+	gpio_direction_output(USB_PT1_EN, 1);
+	gpio_direction_output(USB_PT2_EN, 1);
+	gpio_direction_output(USB_PT3_EN, 1);
+
+	//SOC FAN
+	gpio_request(SOC_FAN_EN, "SOC_FAN_EN");
+	gpio_direction_output(SOC_FAN_EN, 1);
+
+	gpio_request(FAN0_EN, "FAN0_EN");
+	gpio_direction_output(FAN0_EN, 1);
+	gpio_request(FAN1_EN, "FAN1_EN");
+	gpio_direction_output(FAN1_EN, 1);
+
+	//WIFI & BT
+	gpio_request(WIFI_RST, "WIFI_RST");
+	gpio_request(WL_WAKE_HOST, "WL_WAKE_HOST");
+	gpio_request(BT_RST, "BT_RST");
+	gpio_request(BT_WAKE_HOST, "BT_WAKE_HOST");
+	gpio_direction_output(WIFI_RST, 1);
+	gpio_direction_output(WL_WAKE_HOST, 1);
+	gpio_direction_output(BT_RST, 1);
+	gpio_direction_output(BT_WAKE_HOST, 1);
+
+	//LED
+	gpio_request(HDD1_LED_R, "HDD1_LED_R");
+	gpio_request(HDD1_LED_B, "HDD1_LED_B");
+	gpio_request(HDD2_LED_R, "HDD2_LED_R");
+	gpio_request(HDD2_LED_B, "HDD2_LED_B");
