 	gpio_direction_output(SOC_FAN_EN, 1);
 
 	gpio_request(FAN0_EN, "FAN0_EN");
-	gpio_direction_output(FAN0_EN, 1);
+	gpio_direction_output(FAN0_EN, 0);
 	gpio_request(FAN1_EN, "FAN1_EN");
