---
 .../linux/edge_ubuntu_emmc_ainas_defconfig    |  8 +--
 .../u-boot/cvi_board_init.c                   | 54 ++++++++++++++++++-
 2 files changed, 58 insertions(+), 4 deletions(-)

diff --git a/boards/sophon/edge_ubuntu_emmc_ainas/linux/edge_ubuntu_emmc_ainas_defconfig b/boards/sophon/edge_ubuntu_emmc_ainas/linux/edge_ubuntu_emmc_ainas_defconfig
