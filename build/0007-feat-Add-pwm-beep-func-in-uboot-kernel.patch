--- a/boards/sophon/edge_ubuntu_emmc_ainas/linux/edge_ubuntu_emmc_ainas_defconfig
+++ b/boards/sophon/edge_ubuntu_emmc_ainas/linux/edge_ubuntu_emmc_ainas_defconfig
@@ -788,7 +788,10 @@ CONFIG_CVITEK_PWM=m
 CONFIG_INPUT_KEYBOARD=y
 CONFIG_KEYBOARD_GPIO=y
 CONFIG_INPUT_MATRIXKMAP=y
-CONFIG_CVITEK_KEYSCAN=m
+CONFIG_CVITEK_KEYSCAN=y
+# BEEPER
+CONFIG_INPUT_MISC=y
+CONFIG_INPUT_PWM_BEEPER=y
 
 CONFIG_RC_CORE=y
 CONFIG_RC_DEVICES=y
@@ -938,5 +941,4 @@ CONFIG_CPUFREQ_DT=y
 CONFIG_CPUFREQ_DT_PLATDEV=y
 # end of CPU Frequency scaling
 
