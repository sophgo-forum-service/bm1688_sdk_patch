From 1f794f9d435b1d0c08b92ae4eefb883606e67bf8 Mon Sep 17 00:00:00 2001
From: "zhangqiang.mo" <zhangqiang.mo@ictrek.com>
Date: Tue, 18 Aug 2026 14:12:48 +0800
Subject: [PATCH 1/3] use default dts if DTS_TYPE is invalid

---
 board/cvitek/cv186x/board.c | 30 ++++++++++++++++++++++++++----
 common/image-fit.c          | 12 ++++++++++++
 2 files changed, 38 insertions(+), 4 deletions(-)

diff --git a/board/cvitek/cv186x/board.c b/board/cvitek/cv186x/board.c
index 708c738723..c0863ab645 100644
--- a/board/cvitek/cv186x/board.c
+++ b/board/cvitek/cv186x/board.c
@@ -602,6 +602,28 @@ int board_init(void)
 #define DTSNAME_MAX_LEN 32
 #define DEFAULT_DTSNAME "config-bm1688_ainas_8G"
 
+/*
+ * Check whether the DTS_TYPE read from OEM info is usable.
+ * A valid value is a printable ASCII string terminated with '\0' within
+ * DTSNAME_MAX_LEN bytes. An empty (0x00-filled) field, an erased
+ * (0xff-filled) field, or any non-printable garbage is treated as
+ * "not programmed" so the caller can fall back to DEFAULT_DTSNAME.
+ */
+static int dts_type_is_invalid(const unsigned char *s, int len)
+{
+	int i;
+
+	if (len <= 0 || s[0] == '\0')
+		return 1;
+	for (i = 0; i < len; i++) {
+		if (s[i] == '\0')
+			return 0;
+		if (s[i] == 0xff || s[i] < 0x20 || s[i] > 0x7e)
+			return 1;
+	}
+	return 1;
+}
+
 void get_dts_type_from_oem(unsigned char *dtsname)
 {
 #ifdef CONFIG_EMMC_SUPPORT
@@ -614,8 +636,8 @@ void get_dts_type_from_oem(unsigned char *dtsname)
 	memcpy(dtsname, (void *)(0x120000000 + 0xa0), DTSNAME_MAX_LEN);
 	dtsname[DTSNAME_MAX_LEN - 1] = '\0';
 #endif
-	// use default dts
-	if (strlen(dtsname) == 0)
+	// use default dts if the field is empty, erased (0xff) or garbage
+	if (dts_type_is_invalid((unsigned char *)dtsname, DTSNAME_MAX_LEN))
 		memcpy(dtsname, DEFAULT_DTSNAME, sizeof(DEFAULT_DTSNAME));
 	printf("OEM INFO: DTS_TYPE[%s]\n", dtsname);
 
@@ -631,8 +653,8 @@ void get_dts_type_from_sram(unsigned char *dtsname)
 	memcpy(dtsname, (void *)DTSTYPE_OEM_INFO, DTSNAME_MAX_LEN);
 	dtsname[DTSNAME_MAX_LEN - 1] = '\0';
 #endif
-	/*use default dts*/
-	if (strlen(dtsname) == 0)
+	/* use default dts if the field is empty, erased (0xff) or garbage */
+	if (dts_type_is_invalid((unsigned char *)dtsname, DTSNAME_MAX_LEN))
 		memcpy(dtsname, DEFAULT_DTSNAME, sizeof(DEFAULT_DTSNAME));
 }
 
diff --git a/common/image-fit.c b/common/image-fit.c
index fae41fddba..68b4a7d3a0 100644
--- a/common/image-fit.c
+++ b/common/image-fit.c
@@ -2018,6 +2018,18 @@ int fit_image_load(bootm_headers_t *images, ulong addr,
 			cfg_noffset = fit_conf_get_node(fit,
 							fit_uname_config);
 		}
+		if (cfg_noffset < 0 && fit_uname_config) {
+			/*
+			 * The configuration explicitly requested (e.g. via
+			 * 'bootm <addr>#<config>', usually from DTS_TYPE in
+			 * OEM info) does not exist in this FIT. Fall back to
+			 * the FIT's default configuration so a mismatched
+			 * DTS_TYPE does not stop booting.
+			 */
+			printf("WARNING: FIT configuration '%s' not found, "
+			       "falling back to default\n", fit_uname_config);
+			cfg_noffset = fit_conf_get_node(fit, NULL);
+		}
 		if (cfg_noffset < 0) {
 			puts("Could not find configuration node\n");
 			bootstage_error(bootstage_id +
-- 
2.25.1

