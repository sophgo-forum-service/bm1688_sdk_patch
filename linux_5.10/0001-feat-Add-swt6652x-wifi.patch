+	skw_iw_ops.num_standard = wiphy->wext->num_standard;
+	skw_iw_ops.get_wireless_stats = wiphy->wext->get_wireless_stats;
+#endif
+	return (const void *)&skw_iw_ops;
+
+#else
+	pr_info("CONFIG_WIRELESS_EXT disabled\n");
+	return NULL;
+#endif
+}
