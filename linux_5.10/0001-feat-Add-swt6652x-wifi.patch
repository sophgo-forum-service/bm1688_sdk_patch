+menuconfig SEEKWAVE_BSP_DRIVERS_V20
+	bool "SeekWave Platform Drivers For SeekWave Chip"
+	default n
+	help
+	  This enables the SeekWave BSP/platform drivers required by
+	  SeekWave wireless devices.
+
+config SEEKWAVE_PLD_RELEASE
+	bool "SeekWave platform recovery mode support"
+	depends on SEEKWAVE_BSP_DRIVERS_V20
+	default n
+
+if SEEKWAVE_BSP_DRIVERS_V20
+source "drivers/net/wireless/swt/swt6652x/drivers/seekwaveplatform_v20/usb/Kconfig"
+source "drivers/net/wireless/swt/swt6652x/drivers/seekwaveplatform_v20/sdio/Kconfig"
+source "drivers/net/wireless/swt/swt6652x/drivers/seekwaveplatform_v20/skwutil/Kconfig"
