+int recv_data(int portno, char *buffer, int size)
+{
+	struct edma_port *port;
+	char *data = buffer;
+	int read;
+	struct wcn_pcie_info *priv = get_pcie_device_info();
+
+	if (portno == EDMA_LOOPCHECK_PORT)
+		PCIE_DBG("[+] portno=%d!! \n", portno);
+	if (size == 0)
+		return 0;
+	if (portno >= MAX_PORT_NUM)
+		return -EINVAL;
+	port = &edma_ports[portno];
+	if (!port->state)
+		return -EIO;
+	if (priv->suspend) {
+		PCIE_INFO("PCIe dev is suspended\n");
+		return -EOPNOTSUPP;
+	}
+	read = edma_port_read(port, data, size);
+	if (portno == EDMA_LOOPCHECK_PORT)
+		PCIE_DBG("[-] portno=%d!! \n", portno);
+#if 0
+		if(portno == EDMA_BTCMD_PORT){
+			PCIE_INFO("port%d read=%d:\n", port->portno,read);
+			print_hex_dump(KERN_ERR,"recv_data:",0,16,4,buffer,16,1);
+		}
+#endif
+	return read;
+}
+
+int send_data(int portno, char *buffer, int size)
+{
+	struct edma_port *port = get_edma_port_info(portno);
+	struct wcn_pcie_info *priv = get_pcie_device_info();
+
+	PCIE_DBG("[+]\n");
+	PCIE_DBG("size:%d portno:%d port->state:%s\n", size, portno,
+		 port_state[port->state]);
+	if (size == 0)
+		return 0;
+	if (portno >= MAX_PORT_NUM)
+		return -EINVAL;
+	if (!port->state)
+		return -EIO;
+	if (priv->suspend) {
+		PCIE_INFO("PCIe dev is suspended\n");
+		return -EOPNOTSUPP;
+	}
+	return edma_port_write(port, buffer, size);
+}
