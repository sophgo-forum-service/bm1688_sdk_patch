+	skw_edma_msg_enable(skw);
+
+	skw->edma.pentry = skw_procfs_subdir("edma", skw->pentry);
+
+	for (i = 0; i < SKW_MAX_LMAC_SUPPORT; i++) {
+		char name[32] = {0};
