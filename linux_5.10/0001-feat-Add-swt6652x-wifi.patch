+int skw_vring_set(struct skw_core *skw, void *data, u16 len, int lmac_id);
+u16 skw_vring_available_count(struct skw_tx_vring *tx_vring);
+
+void skw_sync_credit(struct skw_core *skw, int lmac_id);
