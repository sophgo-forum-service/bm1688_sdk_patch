+#if LINUX_VERSION_CODE >= KERNEL_VERSION(3, 16, 0)
+		    const u8 *mac,
+#else
+		    u8 *mac,
+#endif
+		    struct station_parameters *params)
+{
+	return skw_add_station(wiphy, dev, (const u8 *)mac, params);
+}
