+
+#define SKW_JP_PATTERN(ID, WMIN, WMAX, PMIN, PMAX, PRF, PPB, RATE, CHIRP)    \
+{                                                                            \
+	.rule = {                                                            \
+		.type_id = ID,                                               \
+		.width_min = SKW_WIDTH_LOWER(WMIN),                          \
+		.width_max = SKW_WIDTH_UPPER(WMAX),                          \
