--- /dev/null
+++ b/drivers/net/wireless/swt/swt6652x/drivers/skwifi/skw_timer.c
@@ -0,0 +1,238 @@
+// SPDX-License-Identifier: GPL-2.0
+
+/******************************************************************************
+ *
+ * Copyright (C) 2020 SeekWave Technology Co.,Ltd.
+ *
