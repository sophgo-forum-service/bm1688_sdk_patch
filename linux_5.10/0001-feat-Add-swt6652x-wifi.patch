+	default n
+	help
+	  Say Y here to support presuspend.
+
+choice
+	prompt "SWT6652 Log Level"
+	default SWT6652_LOG_DEBUG
+	help
+	  SeekWave log level.
+
+config SWT6652_LOG_ERROR
+	bool "ERROR"
+	help
+	  This feature sets the error log level.
+
+config SWT6652_LOG_WARN
+	bool "WARN"
+	help
+	  This feature sets the warning log level.
+
+config SWT6652_LOG_INFO
+	bool "INFO"
+	help
+	  This feature sets the info log level.
+
+config SWT6652_LOG_DEBUG
+	bool "DEBUG"
+	help
+	  This feature sets the debug log level.
