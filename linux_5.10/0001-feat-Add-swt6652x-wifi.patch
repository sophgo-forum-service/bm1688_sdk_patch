+static int bulkin_read(struct usb_port_struct *port, void *buffer, int size)
+{
+	int retval = -1;
+	struct urb *read_urb;
+	DECLARE_COMPLETION_ONSTACK(done);
+	if (port->state == 0)
+		return -EIO;
+
+	if (port == log_port) {
+		memset(buffer, 0, size);
+	}
+
+	if (port->read_urb) {
+		read_urb = port->read_urb;
+		read_urb->transfer_buffer = buffer;
+		read_urb->transfer_buffer_length = size;
+		read_urb->context = &done;
+		usb_anchor_urb(read_urb, &port->read_submitted);
+		retval = usb_submit_urb(read_urb, GFP_KERNEL);
+		if (retval == 0) {
+			retval = wait_for_completion_interruptible(&done);
+			if (retval == -ERESTARTSYS)
+				usb_kill_urb(read_urb);
+			else if (read_urb->status) {
+				retval = read_urb->status;
+				if (retval == -ENOENT &&
+				    read_urb->actual_length)
+					retval = read_urb->actual_length;
+			} else if (retval == 0)
+				retval = read_urb->actual_length;
+			read_urb->context = NULL;
+		} else {
+			if (retval < 0)
+				usb_unanchor_urb(read_urb);
+			read_urb->context = NULL;
+		}
+	}
+	if (port == log_port) {
+		if (assert_info_print && assert_info_print < 28 &&
+		    retval < 100) {
+			assert_info_print++;
+			if (retval > 4)
+				skw_usb_info("%s", (char *)buffer);
+		}
+		if (retval == 4)
+			assert_info_print = 28;
+	}
+	return retval;
+}
