+static int seekwave_boot_probe(struct platform_device *pdev)
+{
+	int ret;
+	int time_count = 0;
+	struct device *io_bus = NULL;
+
+	if (pdev != &seekwave_device)
+		seekwave_device.name = NULL;
+	boot_data = devm_kzalloc(&pdev->dev, sizeof(struct seekwave_device),
+				 GFP_KERNEL);
+	if (!boot_data) {
+		skwboot_err("%s :kzalloc error !\n", __func__);
+		return -ENOMEM;
+	}
+	mutex_init(&boot_mutex);
+	seekwave_boot_parse_dt(pdev, boot_data);
+	io_bus = skw_get_bus_dev();
+	if (!io_bus && (boot_data->chip_en >= 0)) {
+		skwboot_log("%s :CHIP_RESET AGAIN!\n", __func__);
+		gpio_set_value(boot_data->chip_en, 0);
+		msleep(POWERON_DELAY_TIME);
+		gpio_set_value(boot_data->chip_en, 1);
+		do {
+			msleep(10);
+			io_bus = skw_get_bus_dev();
+		} while (!io_bus && time_count++ < 5);
+	}
+	if (!io_bus) {
+		devm_kfree(&pdev->dev, boot_data);
+		skwboot_err("%s get bus dev fail !\n", __func__);
+		return -ENODEV;
+	}
+	if (!strncmp(io_bus->bus->name, "usb", 3)) {
+		struct usb_device *usb_dev =
+			container_of(io_bus, struct usb_device, dev);
+		if (usb_dev->descriptor.idProduct == 0x6315) {
+			boot_data->iram_file_path = "SWT6652S_IRAM_USB.bin";
+			boot_data->dram_file_path = "SWT6652S_DRAM_USB.bin";
+		} else if (usb_dev->descriptor.idProduct == 0x6621) {
+			boot_data->iram_file_path = "SWT6621S_IRAM_USB.bin";
+			boot_data->dram_file_path = "SWT6621S_DRAM_USB.bin";
+			boot_data->skw_nv_name = "SWT6621S_NV_USB.bin";
+		} else if (usb_dev->descriptor.idProduct == 0x6160) {
+			boot_data->iram_file_path = "SWT6621_IRAM_USB.bin";
+			boot_data->dram_file_path = "SWT6621_DRAM_USB.bin";
+		} else if (usb_dev->descriptor.idProduct == 0x6316) {
+			boot_data->iram_file_path = "SWT6652_IRAM_USB.bin";
+			boot_data->dram_file_path = "SWT6652_DRAM_USB.bin";
+		} else if (usb_dev->descriptor.idProduct == 0x6317) {
+			boot_data->iram_file_path = "SWT6652G_IRAM_USB.bin";
+			boot_data->dram_file_path = "SWT6652G_DRAM_USB.bin";
+		} else {
+			skwboot_warn("%s:unknown usb device: 0x%04x\n",
+				     __func__, usb_dev->descriptor.idProduct);
+		}
+
+	} else if (!strncmp(io_bus->bus->name, "pci", 3)) {
+		boot_data->pdev = pdev;
+		if (container_of(io_bus, struct pci_dev, dev)->device ==
+		    0x6316) {
+			boot_data->iram_file_path = "SWT6652_IRAM_PCIE.bin";
+			boot_data->dram_file_path = "SWT6652_DRAM_PCIE.bin";
+		} else if (container_of(io_bus, struct pci_dev, dev)->device ==
+			   0x6315) {
+			boot_data->iram_file_path = "SWT6652S_IRAM_PCIE.bin";
+			boot_data->dram_file_path = "SWT6652S_DRAM_PCIE.bin";
+		} else if (container_of(io_bus, struct pci_dev, dev)->device ==
+			   0x6317) {
+			boot_data->iram_file_path = "SWT6652G_IRAM_PCIE.bin";
+			boot_data->dram_file_path = "SWT6652G_DRAM_PCIE.bin";
+		} else {
+			skwboot_warn("%s:unknown pci device\n", __func__);
+		}
+	} else if (!strncmp(io_bus->bus->name, "sdio", 4)) {
+		struct sdio_func *sdio_func =
+			container_of(io_bus, struct sdio_func, dev);
+		if (container_of(io_bus, struct sdio_func, dev)->device ==
+		    0x6316) {
+			boot_data->iram_file_path = "SWT6652_IRAM_SDIO.bin";
+			boot_data->dram_file_path = "SWT6652_DRAM_SDIO.bin";
+		} else if (container_of(io_bus, struct sdio_func, dev)->device ==
+			   0x6160) {
+			boot_data->iram_file_path = "SWT6621_IRAM_SDIO.bin";
+			boot_data->dram_file_path = "SWT6621_DRAM_SDIO.bin";
+			//boot_data->skw_nv_name = "SWT6621S_NV_SDIO.bin";
+		} else if (container_of(io_bus, struct sdio_func, dev)->device ==
+			   0x6621) {
+			boot_data->iram_file_path = "SWT6621S_IRAM_SDIO.bin";
+			boot_data->dram_file_path = "SWT6621S_DRAM_SDIO.bin";
+			boot_data->skw_nv_name = "SWT6621S_NV_SDIO.bin";
+		} else if (container_of(io_bus, struct sdio_func, dev)->device ==
+			   0x6315) {
+			boot_data->iram_file_path = "SWT6652S_IRAM_SDIO.bin";
+			boot_data->dram_file_path = "SWT6652S_DRAM_SDIO.bin";
+		} else if (container_of(io_bus, struct sdio_func, dev)->device ==
+			   0x6317) {
+			boot_data->iram_file_path = "SWT6652G_IRAM_SDIO.bin";
+			boot_data->dram_file_path = "SWT6652G_DRAM_SDIO.bin";
+		} else {
+			skwboot_warn("%s:unknown sdio device: 0x%04x\n",
+				     __func__, sdio_func->device);
+		}
+	}
+#if !defined(CONFIG_SEEKWAVE_FIRMWARE_LOAD)
+	ret = skw_firmware_alloc(boot_data);
+	if (ret < 0) {
+		skwboot_err("%s:firmware alloc fail\n", __func__);
+		return -1;
+	}
+#endif
+	ret = skw_boot_init(boot_data);
+	if (ret < 0 && !cp_boot) {
+		skwboot_err("%s:boot init fail\n", __func__);
+		return -1;
+	}
+	boot_data->pdev = pdev;
+	ret = skw_first_boot(boot_data);
+	skwboot_log("%s bus-name=%s\n", __func__, io_bus->bus->name);
+	if (!ret && strncmp(io_bus->bus->name, "usb", 3))
+		skw_bind_boot_driver(io_bus);
+	return ret;
+}
