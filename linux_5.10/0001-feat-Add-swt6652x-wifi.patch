+static int skw_iwpriv_set_er_dcm_rate(struct skw_iface *iface, void *param,
+				      char *args, char *resp, int resp_len)
+{
+	int ret = 0;
+	char *p = NULL, *q = NULL;
+	struct net_device *dev = iface->ndev;
+	struct skw_tlv_set_er_dcm_rate rate = { 0 };
+	u16 temp_val = 0;
+
+	if (!args)
+		return -EINVAL;
+
+	skw_dev_dbg(dev, "args %s\n", args);
+
+	p = args;
+	q = strchr(args, ',');
+	if (!p || !q) {
+		skw_dev_err(dev, "param err\n");
+		return -ENOTSUPP;
+	}
+	temp_val = simple_strtol(p, NULL, 10);
+	if (temp_val > 0xFF) {
+		skw_dev_warn(dev, "para out of range (0 ~ 0xFF) %d\n", temp_val);
+		rate.er = 0xFF;
+	} else {
+		rate.er = temp_val;
+	}
+	skw_dev_dbg(dev, "er rate %d\n", rate.er);
+
+	p = q;
+	if (!p) {
+		skw_dev_warn(dev, "param err\n");
+		return -ENOTSUPP;
+	}
+	temp_val = simple_strtol(p + 1, NULL, 10);
+	if (temp_val > 0xFF) {
+		skw_dev_warn(dev, "para out of range (0 ~ 0xFF) %d\n", temp_val);
+		rate.dcm = 0xFF;
+	} else {
+		rate.dcm = temp_val;
+	}
+	skw_dev_dbg(dev, "dcm rate: %d\n", rate.dcm);
+
+	ret = skw_set_er_dcm_rate(iface->wdev.wiphy, iface->ndev, &rate);
+
+	if (!ret)
+		sprintf(resp, "set ok");
+	else
+		sprintf(resp, "set failed");
+
+	return ret;
+}
