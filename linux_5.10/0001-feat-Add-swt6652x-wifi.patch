+{
+    struct btseekwave_data *data = container_of(work, struct btseekwave_data, log_work);
+    struct sk_buff *skb;
+    uint8_t is_from_cp, pkt_type, *pkt_ptr;
+    if(data)
+    {
+        while ((skb = skb_dequeue(&data->log_queue)))
+        {
