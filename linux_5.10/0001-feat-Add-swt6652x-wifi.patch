+	SKW_HT_MPDU_DENSITY_4 = 5,	/* 4 usec */
+	SKW_HT_MPDU_DENSITY_8 = 6,	/* 8 usec */
+	SKW_HT_MPDU_DENSITY_16 = 7	/* 16 usec */
+};
