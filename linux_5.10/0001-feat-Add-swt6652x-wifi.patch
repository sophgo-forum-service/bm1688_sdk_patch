+const u8 *skw_bss_get_ext_ie(struct cfg80211_bss *bss, u8 ext_eid)
+{
+	const struct cfg80211_bss_ies *ies;
+
+	ies = rcu_dereference(bss->ies);
+	if (!ies)
+		return NULL;
