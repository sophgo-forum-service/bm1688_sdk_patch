+	  Say Y here to support repeater mode.
+
+config SWT6652_EXTERNAL_REGDB
+	bool "Use External Regdomain Database"
+	default n
+	help
+	  Say Y here to disable the regdomain database in the driver.
+
+config SWT6652_TDLS
+	bool "SWT6652 TDLS"
