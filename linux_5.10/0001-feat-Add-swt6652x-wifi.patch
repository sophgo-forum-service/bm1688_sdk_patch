+						PCIE_DBG("ch_id=%d [-]\n",
+							 ch_id);
+						//trace_legacy_edma_irq_handle_exit(__LINE__, ch_id, "[-]");
+						continue;
+					}
+
+					reg_chn_src_int.src_complete_int_clr =
+						1;
+					skw_pcie_write32(DMA_SRC_INT(ch_id),
+							 reg_chn_src_int.u32);
+					node_addr0.addr_l32 = skw_pcie_read32(
+						DMA_SRC_INT_DSCR_HEAD_LOW(
