+int skw_edma_pause(void)
+{
+	struct wcn_pcie_info *priv = get_pcie_device_info();
+	int status, ret;
+
+	msleep(5);
+	skw_pcie_write32(DMA_PAUSE, 0xffffffff);
+	ret = readl_poll_timeout(priv->pcimem + (DMA_PAUSE_DONE - 0x40000000),
+				 status, (status == 0xffffffff), 5, 500);
+	if (ret) {
+#ifdef CONFIG_STR_KEEP_ALIVE
+		PCIE_WARN("Failed to pause,done:0x%08x,rawint:0x%08x\n", status,
+			  skw_pcie_read32(DMA_INT_MASK_STS - 4));
+		return -EBUSY;
+#else
+		int ch;
+		PCIE_WARN("Failed to pause,done:0x%08x,rawint:0x%08x\n", status,
+			  skw_pcie_read32(DMA_INT_MASK_STS - 4));
+		for (ch = 0; ch < MAX_EDMA_COUNT; ch++) {
+			if (!(status & (1 << ch))) {
+				PCIE_INFO("ch::%d\n", ch);
+				close_edma_channel(ch);
+			}
+		}
+		return 0;
+#endif
+	}
+
+	ret = readl_poll_timeout(priv->pcimem + (DMA_REQ_STS - 0x40000000),
+				 status, (status == 0), 5, 500);
+	if (ret) {
+		PCIE_ERR("EDMA is busy\n");
+		return -EBUSY;
+	}
+
+	return 0;
+}
+
+void skw_edma_restore(void)
+{
+	skw_pcie_write32(DMA_PAUSE, 0);
+}
