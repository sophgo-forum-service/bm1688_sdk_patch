+static void skw_print_pcie_msi_info(struct pci_dev *pdev)
+{
+	int i, table_entries_num, pba_entries_num;
+	u16 control, data;
+	u32 addr_lo, addr_hi;
+	u32 vector_table_offset, pba_table_offset;
+	struct wcn_pcie_info *priv = get_pcie_device_info();
+
+	if (priv->msi_en == 1) {
+		if (pdev->msi_cap) {
+			pci_read_config_word(
+				pdev, pdev->msi_cap + PCI_MSI_FLAGS, &control);
+			pci_read_config_dword(
+				pdev, pdev->msi_cap + PCI_MSI_ADDRESS_LO,
+				&addr_lo);
+			if (control & PCI_MSI_FLAGS_64BIT)
+				pci_read_config_dword(
+					pdev,
+					pdev->msi_cap + PCI_MSI_ADDRESS_HI,
+					&addr_hi);
+			pci_read_config_word(
+				pdev,
+				pdev->msi_cap +
+					((control & PCI_MSI_FLAGS_64BIT) ?
+						 PCI_MSI_DATA_64 :
+						 PCI_MSI_DATA_32),
+				&data);
+			PCIE_INFO(
+				"MSI::msi_cap=0x%x, control=0x%x addr=%08x:%08x data=0x%04x\n",
+				pdev->msi_cap, control, addr_hi, addr_lo, data);
+		} else {
+			PCIE_ERR("PCIe MSI capability not found\n");
+		}
+	} else if (priv->msix_en == 1) {
+		if (pdev->msix_cap) {
+			pci_read_config_word(pdev,
+					     pdev->msix_cap + PCI_MSIX_FLAGS,
+					     &control);
+			pci_read_config_dword(pdev,
+					      pdev->msix_cap + PCI_MSIX_TABLE,
+					      &vector_table_offset);
+			pci_read_config_dword(pdev,
+					      pdev->msix_cap + PCI_MSIX_PBA,
+					      &pba_table_offset);
+			PCIE_INFO(
+				"MSI-X::msix_cap=0x%x, control=0x%x, table_offset=0x%x, pba_offset=0x%x\n",
+				pdev->msix_cap, control, vector_table_offset,
+				pba_table_offset);
+			table_entries_num =
+				(control & PCI_MSIX_FLAGS_QSIZE) + 1;
+			vector_table_offset &= ~PCI_MSIX_TABLE_BIR;
+			pba_table_offset &= ~PCI_MSIX_PBA_BIR;
+			for (i = 0; i < table_entries_num; i++) {
+				PCIE_DBG("table[%d] ADDR_LO=0x%08x\n", i,
+					 readl_relaxed(priv->pciaux +
+						       vector_table_offset +
+						       i * 0x10));
+				PCIE_DBG("table[%d] ADDR_HI=0x%08x\n", i,
+					 readl_relaxed(priv->pciaux +
+						       vector_table_offset +
+						       i * 0x10 + 4));
+				PCIE_DBG("table[%d] DATA=0x%08x\n", i,
+					 readl_relaxed(priv->pciaux +
+						       vector_table_offset +
+						       i * 0x10 + 8));
+				PCIE_DBG("table[%d] CONTROL=0x%08x\n", i,
+					 readl_relaxed(priv->pciaux +
+						       vector_table_offset +
+						       i * 0x10 + 0xC));
+			}
+			pba_entries_num = (table_entries_num % 64) ?
+						  (table_entries_num / 64 + 1) :
+						  (table_entries_num / 64);
+			if (pba_entries_num == 0)
+				pba_entries_num = 1;
+			for (i = 0; i < pba_entries_num * 2; i++) {
+				PCIE_DBG("pba[%d]=0x%08x\n", i,
+					 readl_relaxed(priv->pciaux +
+						       pba_table_offset +
+						       i * 4));
+			}
+		} else {
+			PCIE_ERR("PCIe MSI-X capability not found\n");
+		}
+	}
+}
