+	SKW_FCC_PATTERN(2, 0, 5, 150, 230, 1, 23, false),
+	SKW_FCC_PATTERN(3, 6, 10, 200, 500, 1, 16, false),
+	SKW_FCC_PATTERN(4, 11, 20, 200, 500, 1, 12, false),
+	SKW_FCC_PATTERN(5, 50, 100, 1000, 2000, 1, 1, true),
