+static void btseekwave_log_save(struct btseekwave_data *data, uint8_t is_from_cp, uint8_t *log_data, uint16_t log_len)
+{
+    if(data)
+    {
+#if BT_HCI_LOG_EN
+
+        uint32_t q_nums = skb_queue_len(&data->log_queue);
+        if(q_nums < 40)//40 packets
+        {
+            struct sk_buff *log_skb = bt_skb_alloc(log_len + 1, GFP_ATOMIC);
+            if(log_skb)
+            {
+                uint8_t *ptr = skb_put(log_skb, 1);
+                *ptr = is_from_cp;
+                memcpy(skb_put(log_skb, log_len), log_data, log_len);
+
+                skb_queue_tail(&data->log_queue, log_skb);
+
+                schedule_work(&data->log_work);
+            }
+            else
+            {
+                SKWBT_ERROR("%s alloc fail", __func__);
+            }
+        }
+#endif
+    }
+}
