+	int ret = 0;
+	struct wcn_pcie_info *priv = get_pcie_device_info();
+	PCIE_INFO("[+]\n");
+	if (priv->cp_state != CP_READY) {
+		PCIE_INFO("[-]cpsts:%s\n", str_cpsts[priv->cp_state]);
+		return ret;
+	}
+	if (disable) {
+		PCIE_INFO("disable BT CP log \n");
+		disable = 0x10;
+	} else {
+		PCIE_INFO(" enable BT CP log !!\n");
+		disable = 0x18;
+	}
+
+	ret = skw_pcie_elbi_writeb(SKWPCIE_AP2CP_SIG1, disable);
+	if (ret < 0) {
+		PCIE_ERR("[-]send ap2cp sig1 reg fail,%d\n", ret);
+		return ret;
+	}
+	skw_pcie_elbi_writeb(SKW_AP2CP_IRQ_REG, 0x20);
+	disable = disable & 0x8;
+	PCIE_INFO("[-] BT CP log:%s\n", disable ? "enable" : "disable");
+	return ret;
+}
