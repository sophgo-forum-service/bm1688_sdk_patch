+static void check_node_data(u32 if_tx, int ch_id, u32 header_cp, u64 header_ap)
+{
+	struct edma_chn_info *edma_chp = get_edma_channel_info(ch_id);
+	struct wcn_pcie_info *priv = get_pcie_device_info();
+	void *src_header_cpu_addr;
+	char *src_p_payload;
+	u64 src_data_addr;
+	u64 src_data_len;
+	u32 dst_data_addr;
+	u32 dst_data_len;
+	u32 i;
+
+	if ((ch_id >= 10) ||
+	    !get_check_node_data_status()) //all bt ch, other return
+		return;
+
+	if (if_tx) { //tx ap2cp
+		edma_chp->c_seq++;
+
+		/*ap side*/
+		src_header_cpu_addr = edma_coherent_rcvheader_to_cpuaddr(
+			(u64)header_ap, edma_chp);
+		src_data_addr =
+			((EDMA_HDR_T *)((char *)src_header_cpu_addr - 8))
+				->data_addr;
+		src_data_len = ((EDMA_HDR_T *)((char *)src_header_cpu_addr - 8))
+				       ->data_len;
+		//get payload cpu addr
+		src_p_payload =
+			(char *)edma_chp
+				->pld_virt_addr; //(char *)edma_pcieaddr_to_virtaddr(src_data_addr);
+
+		/*cp side*/
+		dst_data_addr = skw_pcie_read32(header_cp - 8);
+		dst_data_len =
+			(skw_pcie_read32(header_cp + 4) & 0xFFFF0000) >> 16;
+		memcpy_fromio(dst_data_buf,
+			      priv->pcimem + 0x300000 +
+				      (dst_data_addr & 0xffff),
+			      dst_data_len);
+#if 0
+		PCIE_INFO("ch_id:%d, 0x%x, 0x%x, 0x%x, w_seq=%d, c_seq=%d\n",ch_id, src_data_len, dst_data_len, dst_data_addr, edma_chp->w_seq, edma_chp->c_seq);
+		for(i=0; i<16; i++){
+			PCIE_INFO("ch_id:%d, %d, 0x%x, 0x%x\n",ch_id, i, src_p_payload[i], dst_data_buf[i]);
+		}
+#endif
+		if (src_data_len != dst_data_len) {
+			PCIE_ERR(
+				"ch_id:%d, src_len=0x%llx, dst_len=0x%x, w_seq=%d, c_seq=%d\n",
+				ch_id, src_data_len, dst_data_len,
+				edma_chp->w_seq, edma_chp->c_seq);
+			skw_pcie_write32(0x40108160, 0x00000d11);
+			send_modem_assert_command_ex();
+			return;
+		}
+		for (i = 0; i < src_data_len; i++) {
+			if (src_p_payload[i] != dst_data_buf[i]) {
+				PCIE_ERR(
+					"ch_id:%d, index=%d, len=0x%llx, src_data=0x%x, dst_data=0x%x, dst_data_addr=0x%x, w_seq=%d, c_seq=%d\n",
+					ch_id, i, src_data_len,
+					src_p_payload[i], dst_data_buf[i],
+					dst_data_addr, edma_chp->w_seq,
+					edma_chp->c_seq);
+				skw_pcie_write32(0x40108160, 0x00000d22);
+				send_modem_assert_command_ex();
+				return;
+			}
+		}
+	}
+	return;
+}
