+static void skw_fw_info_print(struct skw_core *skw, struct seq_file *seq)
+{
+	if (!skw->hw_pdata)
+		return;
+
+	/* Firmware & BSP Info */
+	seq_printf(seq, "Calib File:\t %s\n"
+			"FW Build:\t %s\n"
+			"FW Version:\t %s-%s (BSP-MAC)\n"
+			"BUS Type:\t 0x%x (%s)\n"
+			"Align Size:\t %d\n"
+			"TX Limit:\t %d\n",
+			skw->fw.calib_file,
+			skw->fw.build_time,
+			skw->fw.plat_ver,
+			skw->fw.wifi_ver,
+			skw->hw_pdata->bus_type,
+			skw_bus_name(skw->hw.bus),
+			skw->hw_pdata->align_value,
+			skw->hw.pkt_limit);
+}
