+#ifdef CONFIG_RESCAN_EX
+void skw_pcie_rescan_bus_ex(int force_rescan)
+{
+	struct pci_bus *bus;
+	struct wcn_pcie_info *priv = get_pcie_device_info();
+
+	PCIE_INFO("[+] dev:%px,force_rescan:%d\n", priv->dev, force_rescan);
+	if (!priv->dev || force_rescan) {
+		PCIE_INFO("rescan +++\n");
+		bus = pci_find_bus(0, 0);
+		if (bus) {
+			PCIE_INFO("Rescanning PCI bus %04x:%02x\n",
+				  pci_domain_nr(bus), bus->number);
+			pci_lock_rescan_remove();
+			pci_rescan_bus(bus);
+			pci_unlock_rescan_remove();
+		} else {
+			PCIE_ERR(
+				"PCI root bus 0:0 not found, RC not initialized?\n");
+		}
+		PCIE_INFO("rescan ---\n");
+	} else {
+		PCIE_INFO("SCAN is done!!!\n");
+	}
+	PCIE_INFO("[-]\n");
+}
+#endif
