+	int i = 0, rule_idx = 0;
+	struct net_device *dev = iface->ndev;
+
+	struct skw_regdom regd = { };
+	struct skw_core *skw = NULL;
+	struct skw_reg_rule *rule = &regd.rules[0];
+	struct wiphy *wiphy;
+
+	wiphy = iface->wdev.wiphy;
+	skw = wiphy_priv(wiphy);
+
+	if (!args)
+		return -EINVAL;
+	skw_dev_dbg(dev, "args: %s\n", args);
+
+	p = args;
+	q = strchr(args, ',');
+	if (!p || !q) {
+		skw_dev_err(dev, "parameter error\n");
+		return -ENOTSUPP;
+	} else
+		regd.nr_reg_rules =
+		    (u8) skw_iwpriv_convert_string_to_u(p, q - p);
+	skw_dev_dbg(dev, "nr_reg_rules: %d\n", regd.nr_reg_rules);
+
+	comma_num = regd.nr_reg_rules * 2;
+	skw_dev_dbg(dev, "comma num %d\n", comma_num);
+
+	for (i = 0; i < comma_num; i++) {
+		p = q;
+		q = strchr(p + 1, ',');
+		if (!p || !q) {
+			skw_dev_warn(dev, "param err 1\n");
+			return -ENOTSUPP;
+		}
+
+		temp_val =
+		    (u8) skw_iwpriv_convert_string_to_u(p + 1, q - p - 1);
+		skw_dev_dbg(dev, "start channel: %d, rule_idx %d\n", temp_val, rule_idx);
+		rule[rule_idx].start_channel = temp_val;
+		i++;
+
+		if (i < comma_num - 1) {
+			p = q;
+			q = strchr(p + 1, ',');
+			if (!p || !q) {
+				skw_dev_warn(dev, "param err, i %d\n", i);
+				return -ENOTSUPP;
+			}
+			temp_val =
+			    (u8) skw_iwpriv_convert_string_to_u(p + 1,
+								q - p - 1);
+			rule[rule_idx].nr_channel =
+			    temp_val - rule[rule_idx].start_channel;
+			skw_dev_dbg(dev, "end chn: %d, rule_idx %d\n", temp_val,
+				rule_idx);
+		} else {
+			p = q;
+			q = strchr(p + 1, ',');
+			if (!p) {
+				skw_dev_err(dev, "parameter error\n");
+				return -ENOTSUPP;
+			}
+			temp_val =
+			    (u8) skw_iwpriv_convert_string_to_u(p + 1,
+								q - p - 1);
+			skw_dev_dbg(dev, "end channel: %d, rule_idx %d\n", temp_val,
+				rule_idx);
+			rule[rule_idx].nr_channel =
+			    temp_val - rule[rule_idx].start_channel;
+		}
+		rule_idx++;
+	}
+
+	for (i = 0; i < rule_idx; i++) {
+		skw_dev_dbg(dev, "%d @ %d\n", regd.rules[i].start_channel,
+			regd.rules[i].nr_channel);
+	}
+
+	ret = skw_msg_xmit(wiphy, 0, SKW_CMD_SET_REGD, &regd,
+			   sizeof(regd), NULL, 0);
+
+	if (!ret)
+		skw_dev_dbg(dev, "set regd passed, rules: %d, ret: %d\n",
+			regd.nr_reg_rules, ret);
+	else
+		skw_dev_warn(dev, "failed, rules: %d, ret: %d\n", regd.nr_reg_rules,
+			 ret);
+
+	if (!ret)
+		sprintf(resp, "set ok");
+	else
+		sprintf(resp, "set failed");
+
+	return ret;
+
+}
