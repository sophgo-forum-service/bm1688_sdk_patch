+	SKW_HT_MPDU_DENSITY_0_25 = 1,	/* 1/4 usec */
+	SKW_HT_MPDU_DENSITY_0_5 = 2,	/* 1/2 usec */
+	SKW_HT_MPDU_DENSITY_1 = 3,	/* 1 usec */
