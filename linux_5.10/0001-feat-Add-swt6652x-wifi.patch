+static struct skwifi_cfg *skw_cfg_match(struct skwifi_cfg *table, char *name)
+{
+	int i;
+	struct skwifi_cfg *cfg = NULL;
+
+	for (i = 0; table[i].name != NULL; i++) {
+		if (!strcmp(name, table[i].name)) {
+			cfg = &table[i];
+			break;
+		}
+	}
+
+	return cfg;
+}
