+		.ppb_thresh = SKW_PPB_THRESH_RATE(PPB, RATE),                \
+		.max_pri_tolerance = SKW_PRI_TOLERANCE,                      \
+		.chirp = CHIRP,                                              \
+	}                                                                    \
+}
