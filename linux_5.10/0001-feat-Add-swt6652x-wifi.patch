+void skw_pcie_rescan_bus(void)
+{
+	struct wcn_pcie_info *priv = get_pcie_device_info();
+	unsigned long timeout = jiffies + msecs_to_jiffies(2000); //timeout 2s
+	int timeout_occurred = 0;
+	struct pci_bus *pbus;
+#ifdef CONFIG_RESCAN_RC
+	struct pci_dev *root_port = NULL;
+#endif
+
+	PCIE_INFO("[+]\n");
+	while (port_sta_rec[EDMA_BTCMD_PORT] != 0 ||
+	       port_sta_rec[EDMA_BTACL_PORT] != 0 ||
+	       port_sta_rec[EDMA_BTAUDIO_PORT] != 0 ||
+	       port_sta_rec[EDMA_ISOC_PORT] != 0) {
+		if (time_after(jiffies, timeout)) {
+			PCIE_ERR("BT close timeout 2s\n");
+			timeout_occurred = 1;
+			break;
+		}
+		barrier();
+	}
+	if (!timeout_occurred)
+		PCIE_INFO("bt closed\n");
+
+	if (priv->dev == NULL) {
+		PCIE_ERR("dev is null\n");
+		return;
+	}
+#ifdef CONFIG_RESCAN_RC
+	root_port = pcie_find_root_port(priv->dev);
+	if ((root_port == NULL) || (root_port->bus == NULL)) {
+		PCIE_ERR("root port or bus is null\n");
+		return;
+	}
+	pbus = root_port->bus;
+	PCIE_INFO("rescan rc\n");
+	pci_stop_and_remove_bus_device_locked(root_port);
+#else
+	if (priv->dev->bus == NULL) {
+		PCIE_ERR("bus is null\n");
+		return;
+	}
+	pbus = priv->dev->bus;
+	PCIE_INFO("rescan ep\n");
+	pci_stop_and_remove_bus_device_locked(priv->dev);
+#endif
+#ifndef CONFIG_RESCAN_EX
+	PCIE_INFO("\n");
+	pci_lock_rescan_remove();
+	PCIE_INFO("\n");
+	pci_rescan_bus(pbus);
+	PCIE_INFO("\n");
+	pci_unlock_rescan_remove();
+#endif
+	PCIE_INFO("\n");
+	PCIE_INFO("[-]\n");
+}
