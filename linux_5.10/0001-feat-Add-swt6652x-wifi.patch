+
+static ssize_t skw_pcie_swdump_read(struct file *fp, char __user *buffer,
+				    size_t count, loff_t *pos)
+{
+	int ret;
+
+	ret = skw_pcie_swd_read(buffer, count, pos);
+	return ret;
+}
+
+#define CMD_BUF_SIZE 128
+static ssize_t skw_pcie_mem_write(struct file *file, const char __user *buf,
+				  size_t count, loff_t *ppos)
+{
+	char cmd[CMD_BUF_SIZE];
+	u32 addr, val;
+	char op;
+
+	if (copy_from_user(cmd, buf, min(count, sizeof(cmd) - 1)))
+		return -EFAULT;
+
+	cmd[min(count, sizeof(cmd) - 1)] = '\0';
+
+	if (sscanf(cmd, "%c %x %x", &op, &addr, &val) < 2) {
+		pr_err("Invalid command format. Usage:\n");
+		pr_err("Read:  r <hex_addr>\n");
+		pr_err("Write: w <hex_addr> <hex_value>\n");
+		return -EINVAL;
+	}
+	switch (op) {
+	case 'r':
+		val = skw_pcie_read32(addr);
+		pr_info("Read 0x%x: 0x%08x\n", addr, val);
+		break;
+	case 'w':
+		pr_info("Write 0x%x: 0x%08x\n", addr, val);
+		skw_pcie_write32(addr, val);
+		break;
+	default:
+		pr_err("Unknown operation: %c\n", op);
+		return -EINVAL;
+	}
+
+	return count;
+}
+
+static ssize_t skw_pcie_mem_read(struct file *file, char __user *buf,
+				 size_t count, loff_t *ppos)
+{
+	static char msg[CMD_BUF_SIZE];
+	static int len = 0;
+
+	if (*ppos > 0)
+		return 0;
+
+	len = snprintf(msg, sizeof(msg),
+		       "Use 'echo [r|w] <addr> [val] > /proc/skwmem'\n");
+	if (copy_to_user(buf, msg, len))
+		return -EFAULT;
+
+	*ppos += len;
+	return len;
+}
+
+int is_skipped(u32 offset)
+{
+	int i;
+	u32 skip_offs[] = { 14, 15, 18, 22, 23 };
+
+	for (i = 0; i < sizeof(skip_offs) / sizeof(skip_offs[0]); i++) {
+		if (skip_offs[i] == offset)
+			return 1;
+	}
+	return 0;
+}
+static ssize_t skw_pcie_edmadump_write(struct file *file,
+				       const char __user *buf, size_t count,
+				       loff_t *ppos)
+{
+	char cmd[CMD_BUF_SIZE] = { 0 };
+	int n, i;
+	u32 dump[24] = { 0 };
+
+	if (copy_from_user(&cmd, buf, min(count, sizeof(cmd) - 1)))
+		return -EFAULT;
+
+	cmd[min(sizeof(cmd) - 1, count)] = '\0';
+
+	if (kstrtoint(cmd, 10, &n)) {
+		printk("Invalid input: %s\n", cmd);
+		return -EINVAL;
+	}
+
+	memset(dump, 0xee, sizeof(dump));
+	for (i = 0; i < 24; i++) {
+		if (is_skipped(i)) {
+			continue;
+		}
+		dump[i] = skw_pcie_read32(0x40188080 + n * 0x80 + i * 4);
+	}
+	pr_err("\n\n\n\n");
+	for (i = 0; i < 24; i += 4) {
+		if (i % 4 == 0)
+			PCIE_INFO("0x%08x:0x%08x 0x%08x 0x%08x 0x%08x\n",
+				  0x40188080 + n * 0x80 + i * 4, dump[i],
+				  dump[i + 1], dump[i + 2], dump[i + 3]);
+	}
+	pr_err("\n\n\n\n");
+	return count;
+}
+
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 6, 0)
+static const struct proc_ops skw_pcie_swdump_fops = {
+	.proc_read = skw_pcie_swdump_read,
+	.proc_write = skw_pcie_swdump_write,
+};
+
+static const struct proc_ops skw_mem_proc_fops = {
+	.proc_read = skw_pcie_mem_read,
+	.proc_write = skw_pcie_mem_write,
+};
+
+static const struct proc_ops skw_edmadump_proc_fops = {
+	.proc_write = skw_pcie_edmadump_write,
+};
+
+#else
+static const struct file_operations skw_pcie_swdump_fops = {
+	.owner = THIS_MODULE,
+	.read = skw_pcie_swdump_read,
+	.write = skw_pcie_swdump_write,
+};
+
+static const struct file_operations skw_mem_proc_fops = {
+	.owner = THIS_MODULE,
+	.read = skw_pcie_mem_read,
+	.write = skw_pcie_mem_write,
+};
+
+static const struct file_operations skw_edmadump_proc_fops = {
+	.write = skw_pcie_edmadump_write,
+};
+
+#endif
