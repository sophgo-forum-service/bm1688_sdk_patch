+			seq_puts(seq, "\n");
+		}
+
+		SKW_KFREE(inst_tsf);
+	}
+
+	len = sizeof(struct skw_debug_info_w) + sizeof(struct skw_tlv);
+	w_info = SKW_ZALLOC(len, GFP_KERNEL);
