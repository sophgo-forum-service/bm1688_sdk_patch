+static inline void skw_set_extra_hdr(struct skw_core *skw, void *extra_hdr,
+				u8 chn, u16 len, u16 pad, u8 eof)
+{
+	u32 *hdr = extra_hdr;
+	struct skw_hw_extra *ext = &skw->hw.extra;
+
+	*hdr = chn << ext->chn_offset |
+	       (len - ext->hdr_len) << ext->len_offset |
+	       (!!eof) << ext->eof_offset;
+}
