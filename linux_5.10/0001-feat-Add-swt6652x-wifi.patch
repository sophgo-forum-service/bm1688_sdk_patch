+int get_service_busy_sts(void)
+{
+	int ret;
+	u32 status;
+	u32 timeout = 1000000;
+
+	struct wcn_pcie_info *priv = get_pcie_device_info();
+
+	PCIE_INFO("allow wifi suspend timeout::%d\n", timeout);
+	ret = readl_poll_timeout(priv->pcimem + 0x108160, status,
+				 ((status & WIFI_DO_SUSPEND_MASK) == 0), 10,
+				 timeout);
+	if (ret) {
+		PCIE_ERR("Service doesn't allow suspend!!!\n");
+		return -1;
+	}
+
+	return 0;
+}
