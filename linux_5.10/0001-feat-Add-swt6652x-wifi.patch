+static int skw_cfg80211_sched_scan_stop(struct wiphy *wiphy,
+			struct net_device *dev, u64 reqid)
+{
+	return skw_sched_scan_stop(wiphy, dev, reqid);
+}
+#else
+static int skw_cfg80211_sched_scan_stop(struct wiphy *wiphy,
+			struct net_device *dev)
+{
+	return skw_sched_scan_stop(wiphy, dev, 0);
+}
+#endif
