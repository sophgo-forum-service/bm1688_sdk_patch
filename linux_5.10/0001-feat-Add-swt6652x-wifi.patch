+int skw_pcie_set_suspend_indication(void)
+{
+	int ret = 0;
+	struct wcn_pcie_info *priv = get_pcie_device_info();
+	PCIE_INFO("[+]\n");
+	if (priv->cp_state != CP_READY) {
+		PCIE_INFO("[-]cpsts:%s\n", str_cpsts[priv->cp_state]);
+		return ret;
+	}
+
+	ret = skw_pcie_elbi_writeb(SKWPCIE_AP2CP_SIG1, 0x02);
+	if (ret < 0) {
+		PCIE_ERR("[-]send ap2cp sig reg fail,%d\n", ret);
+		return ret;
+	}
+	skw_pcie_elbi_writeb(SKW_AP2CP_IRQ_REG, 0x20);
+	PCIE_INFO("[-]\n");
+	return ret;
+}
+
+int skw_pcie_set_resume_indication(void)
+{
+	int ret = 0;
+	struct wcn_pcie_info *priv = get_pcie_device_info();
+	PCIE_INFO("[+]\n");
+	if (priv->cp_state != CP_READY) {
+		PCIE_INFO("[-]cpsts:%s\n", str_cpsts[priv->cp_state]);
+		return ret;
+	}
+
+	ret = skw_pcie_elbi_writeb(SKWPCIE_AP2CP_SIG1, 0x04);
+	if (ret < 0) {
+		PCIE_ERR("[-]send ap2cp sig reg fail,%d\n", ret);
+		return ret;
+	}
+	skw_pcie_elbi_writeb(SKW_AP2CP_IRQ_REG, 0x20);
+	msleep(1); //waitting for cp switch 2p5g
+	PCIE_INFO("[-]\n");
+	return ret;
+}
