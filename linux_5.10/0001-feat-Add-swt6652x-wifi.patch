+	SKW_CASE_CIPHER_TYPE(BIP_GMAC_128);
+	SKW_CASE_CIPHER_TYPE(BIP_GMAC_256);
+	SKW_CASE_CIPHER_TYPE(GCMP);
+	SKW_CASE_CIPHER_TYPE(GCMP_256);
+
+	default:
+		break;
+	}
