+static void skw_config_mib_free(struct list_head *head)
+{
+	struct skw_mib_data *md, *tmp;
+
+	list_for_each_entry_safe(md, tmp, head, list) {
+		if (md->type == SKW_TYPE_STRING)
+			kfree((void *)md->value);
+
+		kfree(md);
+	}
+}
