+
+mm_segment_t skwbt_get_fs(void)
+{
+    mm_segment_t oldfs;
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 9, 0)
+    oldfs = force_uaccess_begin();
+#else
+    oldfs = get_fs();
+    set_fs(KERNEL_DS);
+#endif
+
+    return oldfs;
+}
+
+void skwbt_set_fs(mm_segment_t fs)
+{
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 9, 0)
+    force_uaccess_end(fs);
+#else
+    set_fs(fs);
+#endif
+
+}
