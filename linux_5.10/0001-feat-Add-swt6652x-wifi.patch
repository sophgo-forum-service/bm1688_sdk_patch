+/************************************************************************
+ *Decription:check dev ready for boot
+ *Author:junwei.jiang
+ *Date:2022-06-07
+ *Modfiy:
+ *
+ ********************************************************************* */
+int skw_reset_bus_dev(void)
+{
+	struct usb_port_struct *port = NULL;
+	int ret = 0;
+	if (chip_en_gpio >= 0) {
+		skw_chip_power_reset();
+	} else {
+		port = usb_ports[0];
+		if (port && port->udev) {
+			ret = usb_control_msg(port->udev,
+					      usb_sndctrlpipe(port->udev, 0),
+					      VENDOR_MSG_MODEM_RESET,
+					      USB_DIR_OUT | USB_TYPE_VENDOR |
+						      USB_RECIP_DEVICE,
+					      0, 0, NULL, 0, 100);
+			skw_usb_info("reset ret = %d\n", ret);
+			if (ret == -ETIMEDOUT)
+				usb_reset_device(port->udev);
+		}
+	}
+	return ret;
+}
