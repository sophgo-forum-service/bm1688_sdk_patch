+	int ret = 0;
+
+	skw_resume_check();
+	skw_sdio_transfer_enter();
+	sdio_claim_host(func);
+	ret = sdio_readsb(func, src, SKW_SDIO_PK_MODE_ADDR, len);
+	sdio_release_host(func);
+	if (ret != 0)
+		skw_sdio_abort(ret);
+	skw_sdio_transfer_exit();
+	return ret;
