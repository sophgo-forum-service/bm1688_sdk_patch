+unsigned int crc_16_l_calc(char *buf_ptr, unsigned int len)
+{
+	unsigned int i;
+	unsigned short crc = 0;
+
+	while (len-- != 0) {
+		for (i = CRC_16_L_SEED; i != 0; i = i >> 1) {
+			if ((crc & CRC_16_L_POLYNOMIAL) != 0) {
+				crc = crc << 1;
+				crc = crc ^ CRC_16_POLYNOMIAL;
+			} else {
+				crc = crc << 1;
+			}
+
+			if ((*buf_ptr & i) != 0) {
+				crc = crc ^ CRC_16_POLYNOMIAL;
+			}
+		}
+		buf_ptr++;
+	}
+	return (crc);
+}
