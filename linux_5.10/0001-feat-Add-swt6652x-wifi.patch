+static int skw_fw_file_read(const char *fw_path, char **fw_data,
+			    unsigned int *fw_size)
+{
+	struct file *filp;
+	loff_t pos = 0;
+	ssize_t ret;
+	char *buf;
+	filp = filp_open(fw_path, O_RDONLY, 0);
+	if (IS_ERR(filp))
+		return PTR_ERR(filp);
+
+	*fw_size = i_size_read(file_inode(filp));
+	if (*fw_size == 0) {
+		filp_close(filp, NULL);
+		return -EINVAL;
+	}
+	buf = skw_malloc(*fw_size, GFP_KERNEL);
+	if (!buf) {
+		filp_close(filp, NULL);
+		return -ENOMEM;
+	}
+	ret = skw_read_file(filp, buf, *fw_size, &pos);
+	filp_close(filp, NULL);
+
+	if (ret < 0 || ret != *fw_size) {
+		skw_free(buf);
+		return ret < 0 ? ret : -EIO;
+	}
+	*fw_data = buf;
+	return 0;
+}
