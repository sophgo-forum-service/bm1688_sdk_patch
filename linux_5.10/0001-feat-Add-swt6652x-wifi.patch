+	struct sk_buff_head *list;
+};
+
+struct skw_tx_lmac {
+	bool reset;
+	int cred;
+	u16 txq_map;
+	u16 nr_txq;
+	int bk_tx_limit;
+	int current_qlen;
+	int ac_reset;
+	int tx_count_limit;
+	int pending_qlen;
+
