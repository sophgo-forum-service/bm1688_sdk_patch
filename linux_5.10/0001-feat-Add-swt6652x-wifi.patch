+static int skw_check_cp_ready(void)
+{
+#include <linux/iopoll.h>
+	u32 status;
+	int ret;
+	struct wcn_pcie_info *priv = get_pcie_device_info();
+
+	ret = readl_poll_timeout(priv->pcimem + 0x188034, status,
+				 ((status & 0xFF000000) == 0x03000000), 10,
+				 1000000);
+	if (ret)
+		PCIE_ERR("check CP-status Error::0x%x,0x%x,0x%x!!!\n",
+			 skw_pcie_read32(0x40100040),
+			 skw_pcie_read32(FW_DL_DONE_REG_BASE),
+			 skw_pcie_read32(FW_BOOT_REG_BASE));
+
+	PCIE_INFO("check CP-ready Enter!!\n");
+	if (wait_for_completion_timeout(&priv->download_done,
+					msecs_to_jiffies(3000)) == 0) {
+		PCIE_ERR("check CP-ready time out\n");
+		return -ETIME;
+	}
+	PCIE_INFO("check CP-ready Passed!!\n");
+	return 0;
+}
