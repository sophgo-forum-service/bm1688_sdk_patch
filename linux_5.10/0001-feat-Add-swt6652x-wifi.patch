+int skw_notify_ep_enter_l2(void)
+{
+	u32 val, status;
+	int ret, i;
+	struct wcn_pcie_info *priv = get_pcie_device_info();
+
+	for (i = 0; i < 3; i++) {
+		val = skw_pcie_read32(SKW_CP_PMU_SW_REG);
+		val &= ~L2_SHAKE_MASK;
+		val |= 0xd2;
+		skw_pcie_write32(SKW_CP_PMU_SW_REG, val);
+		ret = readl_poll_timeout(priv->pcimem + 0x108160, status,
+					 ((status & L2_SHAKE_MASK) == 0xd2), 5,
+					 100);
+		if (ret) {
+			PCIE_ERR(
+				"ENTER L2 failed to read SKW_CP_PMU_SW_REG i=%d\n",
+				i);
+		} else {
+			PCIE_INFO(
+				"ENTER L2 passed to read SKW_CP_PMU_SW_REG i=%d\n",
+				i);
+			break;
+		}
+	}
+	if (i == 3)
+		goto error;
+	/* for cp no edma req */
+	mdelay(1);
+	return 0;
+error:
+	return -1;
+}
+
+void skw_notify_ep_exit_l2(void)
+{
+	u32 val, status;
+	int ret, i;
+	struct wcn_pcie_info *priv = get_pcie_device_info();
+
+	for (i = 0; i < 3; i++) {
+		val = skw_pcie_read32(SKW_CP_PMU_SW_REG);
+		val &= ~L2_SHAKE_MASK;
+		skw_pcie_write32(SKW_CP_PMU_SW_REG, val);
+
+		ret = readl_poll_timeout(priv->pcimem + 0x108160, status,
+					 ((status & L2_SHAKE_MASK) == 0x0), 5,
+					 100);
+		if (ret) {
+			PCIE_ERR(
+				"EXIT L2 failed to read SKW_CP_PMU_SW_REG i=%d\n",
+				i);
+		} else {
+			PCIE_INFO(
+				"EXIT L2 passed to read SKW_CP_PMU_SW_REG i=%d\n",
+				i);
+			break;
+		}
+	}
+}
