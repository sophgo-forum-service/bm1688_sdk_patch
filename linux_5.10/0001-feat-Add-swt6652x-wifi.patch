+int skw_print_pcie_speed(struct pci_dev *pdev)
+{
+	u16 lnksta, speed, width;
+	int pos = pci_find_capability(pdev, PCI_CAP_ID_EXP);
+
+	if (pos) {
+		pci_read_config_word(pdev, pos + PCI_EXP_LNKSTA, &lnksta);
+
+		speed = lnksta & PCI_EXP_LNKSTA_CLS;
+		width = (lnksta & PCI_EXP_LNKSTA_NLW) >> 4;
+
+		PCIE_INFO("PCIe link speed: Gen%u, width x%u\n", speed, width);
+	} else {
+		PCIE_ERR("PCIe capability not found\n");
+		return -1;
+	}
+	return speed;
+}
