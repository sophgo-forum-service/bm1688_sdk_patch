+static int skw_get_bss_channel(struct ieee80211_mgmt *mgmt, int len)
+{
+	const u8 *tmp;
+	int chn = -1;
+	const u8 *ie = mgmt->u.beacon.variable;
+	size_t ielen = len - offsetof(struct ieee80211_mgmt,
+				u.probe_resp.variable);
+
+	tmp = cfg80211_find_ie(WLAN_EID_DS_PARAMS, ie, ielen);
+	if (tmp && tmp[1] == 1) {
+		chn = tmp[2];
+	} else {
+		tmp = cfg80211_find_ie(WLAN_EID_HT_OPERATION, ie, ielen);
+		if (tmp && tmp[1] >= sizeof(struct ieee80211_ht_operation)) {
+			struct ieee80211_ht_operation *htop = (void *)(tmp + 2);
+
+			chn = htop->primary_chan;
+		}
+	}
+
+	return chn;
+}
+
+static bool skw_mgmt_check_ssid(struct skw_core *skw, struct skw_iface *iface,
+				 void *buf, int len, u8 *ssid, u8 *ssid_len)
+{
+	struct skw_mgmt_hdr *hdr = buf;
+	struct ieee80211_mgmt *mgmt = hdr->mgmt;
+	const u8 *elmt_addr = NULL;
+	u16 ies_len = len - sizeof(struct skw_mgmt_hdr) -
+		offsetof(struct ieee80211_mgmt, u.probe_resp.variable);
+
+	elmt_addr = cfg80211_find_ie(WLAN_EID_SSID, (mgmt->u.beacon.variable), ies_len);
+	if (!elmt_addr)
+		return false;
+
+
+	*ssid_len = elmt_addr[SKW_MAC_INFOELT_LEN_OFT];
+	if (*ssid_len > IEEE80211_MAX_SSID_LEN) {
+		memcpy(ssid, (elmt_addr + SKW_MAC_INFOELT_INFO_OFT), IEEE80211_MAX_SSID_LEN);
+
+		skw_err("error,bssid=%pM,fcl=0x%X,ssid_len=%d,ssid=%s\n",
+			mgmt->bssid, mgmt->frame_control, *ssid_len, ssid);
+
+		skw_hex_dump("scan_report error:", buf, len, false);
+
+		return false;
+	}
+
+	memcpy(ssid, (elmt_addr + SKW_MAC_INFOELT_INFO_OFT), *ssid_len);
+
+	skw_log(SKW_SCAN, "[%s] bssid=%pM,fcl=0x%X,ssid_len=%d,ssid=%s\n",
+			SKW_TAG_SCAN, mgmt->bssid, mgmt->frame_control, *ssid_len, ssid);
+
+	return true;
+}
+
+static bool skw_check_6G_channel(struct skw_core *skw, struct skw_iface *iface,
+				 void *buf, int len, u8 *ssid, u8 *ssid_len)
+{
+	struct wiphy *wiphy = priv_to_wiphy(skw);
+	struct skw_mgmt_hdr *hdr = buf;
+	struct ieee80211_mgmt *mgmt = hdr->mgmt;
+	u16 ies_len = len - sizeof(struct skw_mgmt_hdr) -
+		offsetof(struct ieee80211_mgmt, u.probe_resp.variable);
+	const u8 *elmt_addr = NULL;
+	u16 elmt_len = 0;
+	const struct ieee80211_he_operation *he_opr = NULL;
+	const struct ieee80211_he_6ghz_oper *he_6g_opr = NULL;
+	struct cfg80211_bss *bss = NULL;
+	s16 signal = hdr->signal;
+	u8 chan = hdr->chan;
+
+	if (to_nl80211_band(hdr->band) != NL80211_BAND_6GHZ)
+		return true;
+
+	elmt_addr = cfg80211_find_ext_ie(WLAN_EID_EXT_HE_OPERATION, (mgmt->u.beacon.variable), ies_len);
+	if (!elmt_addr) {
+		skw_dbg("error,can not find HE opr.\n");
+		return false;
+	}
+
+	elmt_len = elmt_addr[1];
+	he_opr = (const struct ieee80211_he_operation *)(elmt_addr + 3);
+
+	he_6g_opr = ieee80211_he_6ghz_oper(he_opr);
+	if (!he_6g_opr)
+		return false;
+
+	skw_hex_dump("EXT_6G_OPR:", he_6g_opr, sizeof(*he_6g_opr), false);
+
+	if (he_6g_opr->primary != hdr->chan) {
+
+		hdr->chan = he_6g_opr->primary;
+
+		bss = cfg80211_get_bss(wiphy, ieee80211_get_channel(wiphy, hdr->chan),
+			mgmt->bssid, ssid, *ssid_len, IEEE80211_BSS_TYPE_ESS, IEEE80211_PRIVACY_ANY);
+		if (!bss)
+			hdr->signal = -60;//default rssi
+		else
+			hdr->signal = bss->signal / 100;
+
+		skw_dbg("fix 6G channel,%u->%u,%d->%d,%pM\n",
+			chan, he_6g_opr->primary, signal, hdr->signal, mgmt->bssid);
+	}
+
+	return true;
+}
+
+static int skw_event_scan_report(struct skw_core *skw, struct skw_iface *iface,
+				 void *buf, int len, struct skw_skb_rxcb *cb)
+{
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(3, 17, 0)
+	struct timespec64 ts;
+#endif
+	struct cfg80211_bss *bss = NULL;
+	struct ieee80211_channel *rx_channel = NULL;
+	struct skw_mgmt_hdr *hdr = buf;
+	int freq = ieee80211_channel_to_frequency(hdr->chan,
+				to_nl80211_band(hdr->band));
+	s32 signal = DBM_TO_MBM(hdr->signal);
+	bool is_beacon = ieee80211_is_beacon(hdr->mgmt->frame_control);
+	u8 ssid[IEEE80211_MAX_SSID_LEN + 1] = {0};
+	u8 ssid_len = 0;
+
+	skw_log(SKW_SCAN, "[%s] bssid: %pM, band:%u, chn: %d, signal: %d, %s\n",
+		SKW_TAG_SCAN, hdr->mgmt->sa, hdr->band, hdr->chan, hdr->signal,
+		is_beacon ? "beacon" : "probe resp");
+
+	if (unlikely(!iface)) {
+		skw_warn("iface invalid\n");
+		return -EINVAL;
+	}
+
+	if (!skw_mgmt_check_ssid(skw, iface, buf, len, ssid, &ssid_len))
+		return -EINVAL;
+
+	if (!skw_check_6G_channel(skw, iface, buf, len, ssid, &ssid_len)) {
+		skw_err("6G invalid, freq: %d, channel: %d\n", freq, hdr->chan);
+		return -EINVAL;
+	}
+
+	freq = ieee80211_channel_to_frequency(hdr->chan,
+				to_nl80211_band(hdr->band));
+	signal = DBM_TO_MBM(hdr->signal);
+
+	rx_channel = ieee80211_get_channel(iface->wdev.wiphy, freq);
+	if (!rx_channel) {
+		skw_err("invalid, freq: %d, channel: %d\n", freq, hdr->chan);
+		return -EINVAL;
+	}
+
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(3, 17, 0)
+	ts = ktime_to_timespec64(ktime_get_boottime());
+	hdr->mgmt->u.probe_resp.timestamp = ((u64)ts.tv_sec*1000000)
+						+ ts.tv_nsec / 1000;
+#else
+	hdr->mgmt->u.probe_resp.timestamp = ktime_get_boottime().tv64;
+	do_div(hdr->mgmt->u.probe_resp.timestamp,  1000);
+#endif
+
+	bss = cfg80211_inform_bss_frame(iface->wdev.wiphy, rx_channel,
+					hdr->mgmt, hdr->mgmt_len,
+					signal, GFP_KERNEL);
+	if (unlikely(!bss)) {
+		int bss_chn = skw_get_bss_channel(hdr->mgmt, hdr->mgmt_len);
+
+		skw_dbg("failed, bssid: %pM, chn: %d, rx chn: %d, flags: %d\n",
+			hdr->mgmt->bssid, bss_chn, hdr->chan, rx_channel->flags);
+
+		return 0;
+	}
+
+	skw->nr_scan_results++;
+
+	if (test_bit(SKW_FLAG_MBSSID_PRIV, &skw->flags) && bss) {
+
+		skw_bss_priv(bss)->bssid_index = 0;
+		skw_bss_priv(bss)->max_bssid_indicator = 0;
+
+		skw_mbssid_data_parser(iface->wdev.wiphy, is_beacon,
+			rx_channel, signal, hdr->mgmt, hdr->mgmt_len);
+	}
+
+	cfg80211_put_bss(iface->wdev.wiphy, bss);
+
+	return 0;
+}
+
+int skw_mgmt_tx_status(struct skw_iface *iface, u64 cookie,
+			   const u8 *frame, int frame_len, u16 ack)
+{
+	// fixme:
+	// check this tx status is for driver or for apps
+	switch (iface->wdev.iftype) {
+	case NL80211_IFTYPE_STATION:
+	case NL80211_IFTYPE_P2P_CLIENT:
+	case NL80211_IFTYPE_P2P_DEVICE:
+		cfg80211_mgmt_tx_status(&iface->wdev, cookie,
+					frame, frame_len,
+					ack, GFP_KERNEL);
+
+		break;
+
+	case NL80211_IFTYPE_AP:
+	case NL80211_IFTYPE_P2P_GO:
+		skw_mlme_ap_tx_status(iface, cookie, frame,
+					frame_len, ack);
+		break;
+
+	default:
+		break;
+	}
+
+	return 0;
+}
