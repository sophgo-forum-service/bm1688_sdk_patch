+static void skw_free(void *ptr)
+{
+	//check is_vmalloc_addr ptr need check CONFIG_MMU
+	//skwboot_log("%s CONFIG_MMU:%d \n", __func__,IS_ENABLED(CONFIG_MMU));
+	if (!ptr)
+		return;
+	else
+		return vfree(ptr);
