+static int inline is_msi_irq_wifi_takeover(struct wcn_pcie_info *priv, int irq)
+{
+#ifdef SKW_PCIE_TEST
+	return 0;
+#else
+	int ch_id;
+
+	if (priv->msix_en == 1) {
+		ch_id = irq / 2;
+	} else
+		ch_id = irq;
+
+	if (ch_id == EDMA_WIFI_TX0_FREE_ADDR ||
+	    ch_id == EDMA_WIFI_TX1_FREE_ADDR ||
+	    ch_id == EDMA_WIFI_RX0_PKT_ADDR ||
+	    ch_id == EDMA_WIFI_RX1_PKT_ADDR ||
+	    ch_id == EDMA_WIFI_RX0_FILTER_DATA_CHN ||
+	    ch_id == EDMA_WIFI_RX1_FILTER_DATA_CNH ||
+	    ch_id == EDMA_WIFI_TX0_PACKET_ADDR ||
+	    ch_id == EDMA_WIFI_TX1_PACKET_ADDR)
+
+		return 1;
+	else
+		return 0;
+#endif
+}
