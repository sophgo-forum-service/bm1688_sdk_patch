+static int skw_usb_bluetooth_log(int disable)
+{
+	struct usb_port_struct *port;
+	int ret = -1;
+
+	if (disable) {
+		skw_usb_info("disable the CP log \n");
+		disable = 0x2;
+	} else {
+		skw_usb_info(" enable the CP log !!\n");
+		disable = 0x6;
+	}
+
+	port = usb_ports[0];
+	if (port && port->state) {
+		ret = usb_control_msg(
+			port->udev, usb_sndctrlpipe(port->udev, 0),
+			VENDOR_MSG_LOG_SWITCH,
+			USB_DIR_OUT | USB_TYPE_VENDOR | USB_RECIP_DEVICE,
+			disable, 0, NULL, 0, 10);
+		skw_usb_info("(disable=%d) ret = %d\n", disable, ret);
+	}
+	return ret;
+}
