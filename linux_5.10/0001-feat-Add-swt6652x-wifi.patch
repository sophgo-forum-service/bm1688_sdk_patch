+#if 0
+	iface->sta.backup = SKW_KMEMDUP(&iface->sta.core.bss,
+					sizeof(iface->sta.core.bss),
+					GFP_KERNEL);
+	if (!iface->sta.backup)
+		return -EINVAL;
+
+	// skw_peer_transmit();
+	memset(&iface->sta.core.bss, 0x0, sizeof(iface->sta.core.bss));
