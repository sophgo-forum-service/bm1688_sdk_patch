+static int skw_iwpriv_get_mtemp(struct skw_iface *iface, void *param,
+				char *args, char *resp, int resp_len)
+{
+	u8 *rdreg_info = NULL;
+	int len = 0;
+	struct skw_tlv_get_mtemp_info *rdreg_rsp = NULL;
+	int ret = 0;
+	struct net_device *dev = iface->ndev;
+
+	struct skw_debug_info_s debug_info_param = { 0 };
+	debug_info_param.tlv = SKW_MIB_GET_MODULE_TEMP_E;
+
+	len = sizeof(struct skw_tlv_get_mtemp_info) + sizeof(struct skw_tlv);
+	rdreg_info = SKW_ZALLOC(len, GFP_KERNEL);
+	if (!rdreg_info) {
+		skw_dev_err(dev, "malloc rtreg_info failed\n");
+		return -ENOMEM;
+	}
+
+	skw_dev_dbg(dev, "len %d\n", len);
+
+	ret = skw_get_mtemp(iface->skw, &debug_info_param, rdreg_info, len);
+	if (!ret) {
+		rdreg_rsp =
+		    (struct skw_tlv_get_mtemp_info *)(rdreg_info +
+						      sizeof(struct skw_tlv));
+		skw_dev_dbg(dev, "module temperature: %d\n", rdreg_rsp->mtemp);
+	}
+
+	if (!ret) {
+		sprintf(resp, "get ok");
+	} else {
+		sprintf(resp, "get failed");
+	}
+
+	SKW_KFREE(rdreg_info);
+	return 0;
+
+}
