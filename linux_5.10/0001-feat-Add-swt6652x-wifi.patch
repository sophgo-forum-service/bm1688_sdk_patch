+//get mtemp
+int skw_get_mtemp(struct skw_core *skw, struct skw_debug_info_s *param,
+		  u8 *buf, int len)
+{
+	int ret = -1;
+	struct skw_tlv *tlv;
+
+	ret = skw_msg_xmit(priv_to_wiphy(skw), 0, SKW_CMD_GET_DEBUG_INFO,
+			   param, sizeof(struct skw_debug_info_s), buf, len);
+
+	if (ret) {
+		skw_warn("failed, ret: %d\n", ret);
+		return ret;
+	}
+
+	tlv = (struct skw_tlv *)buf;
+	if (tlv->type != SKW_MIB_GET_MODULE_TEMP_E ||
+	    tlv->len != sizeof(struct skw_tlv_get_mtemp_info)) {
+		skw_warn("type or len not match\n");
+		return -1;
+	}
+
+	return 0;
+}
