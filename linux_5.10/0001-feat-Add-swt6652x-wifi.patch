+		(char *)skw_malloc(DRAM_IMG_SIZE, GFP_KERNEL);
+	if (!boot_data->dram_img_data) {
+		skwboot_err("%s,line:%d the dram img data malloc fail \n",
+			    __func__, __LINE__);
