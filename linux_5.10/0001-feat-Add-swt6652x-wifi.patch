+int skw_pcie_reset_chip(void)
+{
+	if (chip_en_dis == 2) {
+		u32 val;
+
+		PCIE_INFO("soft rst\n");
+
+#if 0
+		skw_pcie_write32(0x40124004, 0x10000);
+		msleep(1);
+		skw_pcie_write32(0x40124004, 0x00000);
+#endif
+
+		val = skw_pcie_read32(0x40108000);
+		val |= 0x01500000;
+		skw_pcie_write32(0x40108000, val);
+		msleep(1);
+		val = skw_pcie_read32(0x40108000);
+		val |= 0x01d80000;
+		skw_pcie_write32(0x40108000, val);
+		msleep(1);
+		val = skw_pcie_read32(0x40108000);
+		val |= 0x01dc0000;
+		skw_pcie_write32(0x40108000, val);
+		msleep(1);
+
+		skw_pcie_write32(0x40108150, 0);
+
+		val = skw_pcie_read32(0x40100000);
+		val &= ~0x00000300;
+		skw_pcie_write32(0x40100000, val);
+
+		val = skw_pcie_read32(0x40108000);
+		val &= ~0x01dc0000;
+		skw_pcie_write32(0x40108000, val);
+
+		val = skw_pcie_read32(0x40100030);
+		val &= ~0x0000FFFF;
+		skw_pcie_write32(0x40100030, val);
+
+		skw_pcie_write32(0x40108160, 0);
+
+		skw_pcie_write32(0x40100004, 0x7);
+		skw_pcie_write32(0x40100004, 0x0);
+
+		skw_pcie_write32(0x40120004, 0xE);
+		skw_pcie_write32(0x40120004, 0x0);
+
+		val = skw_pcie_read32(0x40100024);
+		val &= ~0x11FFFFFF;
+		val |= 0x2000;
+		skw_pcie_write32(0x40100024, val);
+
+		skw_pcie_write32(0x40000140, 0x0);
+
+		skw_pcie_write32(0x40120600, 0x0);
+		skw_pcie_write32(0x40120608, 0x1);
+		skw_pcie_write32(0x4012060C, 0x1);
+		skw_pcie_write32(0x40120628, 0x0);
+		skw_pcie_write32(0x40120638, 0x0);
+		skw_pcie_write32(0x4012064C, 0x0);
+
+		skw_pcie_write32(0x40108020, 0x00302001);
+		skw_pcie_write32(0x401080E0, 0x00003);
+		msleep(200);
+		skw_pcie_write32(0x401080E0, 0x00002);
+		msleep(5);
+		skw_pcie_write32(0x40108020, 0x00302000);
+
+		//skw_pcie_write32(0x4000001C, 0x3);
+
+#if 0
+		PCIE_INFO("\n");
+		skw_pcie_write32(0x40124004, 0x80000);
+		msleep(1);
+		skw_pcie_write32(0x40124004, 0x00000);
+#endif
+
+		skw_pcie_write32(0x40000034, 0x0);
+		msleep(10);
+		skw_pcie_write32(0x40120604, 0x100);
+
+		skw_pcie_write32(0x40124008, 0x1);
+		PCIE_INFO("\n");
+	} else if ((chip_en_dis == 1) || (chip_en_dis == 0)) {
+		u32 val1, val2, val3;
+
+		PCIE_INFO("glb rst\n");
+
+		val1 = skw_pcie_read32(0x40100008);
+		if (val1 == 0xFFFFFFFF) {
+			PCIE_ERR("pcie bus is error::0x%x!!!\n", val1);
+			return -1;
+		}
+		val1 &= ~(0x1F << 16);
+		val1 |= 0x1D << 16 | (0x1 << 1);
+		skw_pcie_write32(0x40100008, val1);
+
+		val2 = skw_pcie_read32(0x40100020);
+		if (val2 == 0xFFFFFFFF) {
+			PCIE_ERR("pcie bus is error::0x%x!!!\n", val2);
+			return -1;
+		}
+		val2 &= ~(0x1 << 15);
+		skw_pcie_write32(0x40100020, val2);
+
+		val3 = skw_pcie_read32(0x40100004);
+		if (val3 == 0xFFFFFFFF) {
+			PCIE_ERR("pcie bus is error::0x%x!!!\n", val3);
+			return -1;
+		}
+		val3 |= 0x1 << 5;
+		skw_pcie_write32(0x40100004, val3);
+		PCIE_INFO("0x%x, 0x%x, 0x%x\n", val1, val2, val3);
+	}
+	return 0;
+}
