+		ret = skw_sdio_bind_WIFI_driver(skw_sdio->sdio_func[FUNC_1]);
+	} else {
+		ret = skw_sdio_unbind_WIFI_driver(skw_sdio->sdio_func[FUNC_1]);
+	}
+	return ret;
+}
