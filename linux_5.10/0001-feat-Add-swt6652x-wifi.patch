+static inline int skw_get_hw_credit(struct skw_core *skw, int lmac_id)
+{
+	struct skw_lmac *lmac = &skw->hw.lmac[lmac_id];
+
+	if (test_bit(SKW_FLAG_FW_IGNORE_CRED, &skw->flags))
+		return INT_MAX;
+
+	return atomic_read(&lmac->fw_credit);
+}
