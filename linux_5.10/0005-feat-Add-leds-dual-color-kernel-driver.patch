Date: Fri, 8 May 2026 18:58:22 +0800
Subject: [PATCH 5/7] [feat]Add leds dual color kernel driver.

Change-Id: I0e74a508be13c8980ce276b3b49767548755230e
---
 drivers/leds/Kconfig           |  15 ++
 drivers/leds/Makefile          |   1 +
 drivers/leds/leds-dual-color.c | 356 +++++++++++++++++++++++++++++++++
 3 files changed, 372 insertions(+)
 create mode 100644 drivers/leds/leds-dual-color.c

diff --git a/drivers/leds/Kconfig b/drivers/leds/Kconfig
index 849d3c5f908e..455efa387811 100644
--- a/drivers/leds/Kconfig
+++ b/drivers/leds/Kconfig
@@ -571,6 +571,21 @@ config LEDS_DA9052
 	  This option enables support for on-chip LED drivers found
 	  on Dialog Semiconductor DA9052-BC and DA9053-AA/Bx PMICs.
 
+config LEDS_DUAL_COLOR
+	tristate "Dual-color LED (two GPIO pins)"
+	depends on GPIOLIB
+	help
+	  This option enables support for dual-color LEDs using two GPIO pins.
+	  Each LED can be blue or red based on GPIO combination:
+	    pin1=high, pin2=low  -> blue on
+	    pin1=low,  pin2=high -> red on
+
+	  Sysfs interface:
+	    /sys/class/leds-dual-color/<name>/state   (0=off, 1=blue, 2=red,
+	                                                3=blue blink, 4=red blink,
+						        5=alternating blink)
+	    /sys/class/leds-dual-color/<name>/blink_ms (blink interval in milliseconds)
+
 config LEDS_DAC124S085
 	tristate "LED Support for DAC124S085 SPI DAC"
 	depends on LEDS_CLASS
