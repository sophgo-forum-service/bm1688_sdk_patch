+#!/bin/bash
+date
+#sudo ./burn_oen.sh
+
+# if [ $# -ne 2 ]; then
+# 	echo "Please enter both the name and value of oem information"
+# 	echo " For examle: ./burn_oem.sh CHIP CV186AH"
+# 	echo "QA_FAIL_OEM"
+# 	exit 1
+# else
+# 	name=$1
+# 	value=$2
+# fi
+
+get_oem_info() {
+    local name=$1
+
+    if [ $name == "SN0" ]; then
+        addr=0
+        count=32
+    elif [ $name == "SN1" ]; then
+        addr=32
+        count=32
+    elif [ $name == "MAC0" ]; then
+        addr=64
+        count=16
+    elif [ $name == "MAC1" ]; then
+        addr=80
+        count=16
+    elif [ $name == "PRODUCT_TYPE" ]; then
+        addr=96
+        count=16
+    elif [ $name == "MODULE_TYPE" ]; then
+        addr=112
+        count=16
+    elif [ $name == "INTERFACE_FLAG" ]; then
+        addr=128
+        count=1
+    elif [ $name == "AGING_FLAG" ]; then
+        addr=129
+        count=1
+    elif [ $name == "CONSOLE_FLAG" ]; then
+        addr=130
+        count=1
+    elif [ $name == "PHY_LED_FLAG" ]; then
+        addr=131
+        count=1
+    elif [ $name == "DDR_SIZE" ]; then
+        addr=240
+        count=2
+    elif [ $name == "VENDER" ]; then
+        addr=144
+        count=16
+    elif [ $name == "DTS_TYPE" ]; then
+        addr=160
+        count=32
+    elif [ $name == "HW_VERSION" ]; then
+        addr=192
+        count=16
+    elif [ $name == "PRODUCT" ]; then
+        addr=208
+        count=16
+    elif [ $name == "CHIP" ]; then
+        addr=224
+        count=16
+    else
+        echo "Unknown OEM field: $name"
+        echo "QA_FAIL_OEM"
+        exit 1
+    fi
+}
+
+burn_oem_func() {
+    local name=$1
+    local value=$2
+
+    get_oem_info "$name"
+
+    if [ $name == "SN0" ] || [ $name == "SN1" ] || [ $name == "MODULE_TYPE" ] || \
+       [ $name == "VENDER" ] || [ $name == "DTS_TYPE" ] || [ $name == "HW_VERSION" ] || \
+       [ $name == "PRODUCT" ] || [ $name == "CHIP" ]; then
+        w_value=$value
+        type="str"
+    else
+        w_value=${value#0x}
+        type="hex"
+    fi
+
+    echo "name: $name"
+    echo "value: $value"
+
+    echo 0 > /sys/block/mmcblk0boot1/force_ro
+    if [ $? -ne 0 ]; then
+        echo "Unlock force_ro failed"
+        echo "QA_FAIL_OEM"
+        exit 1
+    fi
+
+    echo $w_value > ${name}.txt
+    if [ $type == "str" ]; then
+        input_file=${name}.txt
+    elif [ $type == "hex" ]; then
+        xxd -p -u -r ${name}.txt > ${name}.bin
+        input_file=${name}.bin
+    fi
+
+    dd if=/dev/zero of=/dev/mmcblk0boot1 count=$count bs=1 seek=$addr
+    if [ $? -ne 0 ]; then
+        echo "Erase $name failed"
+        echo "QA_FAIL_OEM"
+        exit 1
+    fi
+
+    dd if=$input_file of=/dev/mmcblk0boot1 count=$count bs=1 seek=$addr
+    if [ $? -ne 0 ]; then
+        echo "Burn $name failed"
+        echo "QA_FAIL_OEM"
+        exit 1
+    fi
+    echo "start rm -rf"
+    echo  $input_file
+    rm -rf $input_file ${name}.txt
+
+    echo 1 > /sys/block/mmcblk0boot1/force_ro
+
+}
+
+clear_oem_func() {
+    local name=$1
+
+    get_oem_info "$name"
+
+    echo "clear OEM field: $name (addr=$addr, count=$count)"
+
+    echo 0 > /sys/block/mmcblk0boot1/force_ro
+    if [ $? -ne 0 ]; then
+        echo "Unlock force_ro failed"
+        echo "QA_FAIL_OEM"
+        exit 1
+    fi
+
+    dd if=/dev/zero of=/dev/mmcblk0boot1 count=$count bs=1 seek=$addr
+    if [ $? -ne 0 ]; then
+        echo "Clear $name failed"
+        echo "QA_FAIL_OEM"
+        exit 1
+    fi
+
+    echo 1 > /sys/block/mmcblk0boot1/force_ro
+    echo "Clear $name done"
+}
+
+clear_all_oem_func() {
+    echo "This will clear ALL OEM information (256 bytes), are you sure? (y/N)"
+    read confirm
+    if [ "$confirm" != "y" ] && [ "$confirm" != "Y" ]; then
+        echo "Cancelled"
+        exit 0
+    fi
+
+    echo 0 > /sys/block/mmcblk0boot1/force_ro
+    if [ $? -ne 0 ]; then
+        echo "Unlock force_ro failed"
+        echo "QA_FAIL_OEM"
+        exit 1
+    fi
+
+    dd if=/dev/zero of=/dev/mmcblk0boot1 count=256 bs=1 seek=0
+    if [ $? -ne 0 ]; then
+        echo "Clear all OEM failed"
+        echo "QA_FAIL_OEM"
+        exit 1
+    fi
+
+    echo 1 > /sys/block/mmcblk0boot1/force_ro
+    echo "Clear all OEM done"
+}
+
+list_oem_fields() {
+    echo "Supported OEM fields:"
+    echo "  SN0, SN1"
+    echo "  MAC0, MAC1"
+    echo "  PRODUCT_TYPE, MODULE_TYPE"
+    echo "  INTERFACE_FLAG, AGING_FLAG, CONSOLE_FLAG, PHY_LED_FLAG"
+    echo "  DDR_SIZE"
+    echo "  VENDER, DTS_TYPE, HW_VERSION, PRODUCT, CHIP"
+}
+
+AINAS_8_V2.0_func() {
+    burn_oem_func "CHIP" "BM1688"
+    burn_oem_func "PRODUCT" "AINAS"
+    burn_oem_func "HW_VERSION" "v2.0"
+    burn_oem_func "DTS_TYPE" "config-bm1688_ainas_8G"
+    burn_oem_func "DDR_SIZE" "0x2000"
+}
+
+AINAS_16_V2.0_func() {
+    burn_oem_func "CHIP" "BM1688"
+    burn_oem_func "PRODUCT" "AINAS"
+    burn_oem_func "HW_VERSION" "v2.0"
+    burn_oem_func "DTS_TYPE" "config-bm1688_ainas_16G"
+    burn_oem_func "DDR_SIZE" "0x4000"
+}
+
+AINAS_8_V3.0_func() {
+    burn_oem_func "CHIP" "BM1688"
+    burn_oem_func "PRODUCT" "AINAS"
+    burn_oem_func "HW_VERSION" "v3.0"
+    burn_oem_func "DTS_TYPE" "config-bm1688_ainas_8G"
+    burn_oem_func "DDR_SIZE" "0x2000"
+}
+
+AINAS_16_V3.0_func() {
+    burn_oem_func "CHIP" "BM1688"
+    burn_oem_func "PRODUCT" "AINAS"
+    burn_oem_func "HW_VERSION" "v3.0"
+    burn_oem_func "DTS_TYPE" "config-bm1688_ainas_16G"
+    burn_oem_func "DDR_SIZE" "0x4000"
+}
+
+
+
+echo "Please select operation"
+echo "  Burn OEM (device model):"
+echo "    1:AINAS 8G  V2.0"
+echo "    2:AINAS 16G V2.0"
+echo "    3:AINAS 8G  V3.0"
+echo "    4:AINAS 16G V3.0"
+echo "  Clear OEM:"
+echo "    5:Clear specific OEM field"
+echo "    6:Clear ALL OEM information"
+
+read choice
+
+case $choice in
+	1)
+		AINAS_8_V2.0_func
+	;;
+	2)
+		AINAS_16_V2.0_func
+	;;
+	3)
+		AINAS_8_V3.0_func
+	;;
+	4)
+		AINAS_16_V3.0_func
+	;;
+	5)
+		list_oem_fields
+		echo ""
+		echo "Usage examples:"
+		echo "  Clear SN0    -> input: SN0"
+		echo "  Clear DDR_SIZE -> input: DDR_SIZE"
+		echo "  Clear CHIP    -> input: CHIP"
+		echo ""
+		echo "Please enter the OEM field name to clear:"
+		read field_name
+		clear_oem_func "$field_name"
+	;;
+	6)
+		clear_all_oem_func
+	;;
+	*)
+		echo "please choose 1, 2, 3, 4, 5 or 6"
+	;;
+esac
+
+
+
+date
+echo "QA_PASS_OEM"
